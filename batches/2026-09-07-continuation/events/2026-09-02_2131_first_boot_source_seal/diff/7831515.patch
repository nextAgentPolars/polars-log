+func captureProduceSite(root, path string, function *ast.FuncDecl, site captureCallSite) bool {
+	if function == nil || site.call == nil {
+		return false
+	}
+	assignment, ok := site.parent.(*ast.AssignStmt)
+	if !ok || assignment.Tok != token.DEFINE {
+		return false
+	}
+	selector, ok := captureCallee(site.call.Fun).(*ast.SelectorExpr)
+	if !ok || selector.Sel.Name != "ProduceCapture" {
+		return false
+	}
+	packageIdent, ok := selector.X.(*ast.Ident)
+	if !ok || packageIdent.Name != "intentinventory" {
+		return false
+	}
+	captureFile := filepath.ToSlash(filepath.Join(root, "cmd", "gateway", "bootstrap_capture.go"))
+	sourceFile := filepath.ToSlash(filepath.Join(root, "cmd", "gateway", "bootstrap_source.go"))
+	if path == captureFile {
+		return function.Name.Name == "preCaptureSource" && function.Recv == nil
+	}
+	if path == sourceFile {
+		if function.Name.Name != "capture" || function.Recv == nil || len(function.Recv.List) != 1 {
+			return false
+		}
+		field := function.Recv.List[0]
+		if len(field.Names) != 1 || field.Names[0].Name != "c" {
+			return false
+		}
+		receiver, ok := field.Type.(*ast.Ident)
+		return ok && receiver.Name == "initialCapture"
+	}
+	return false
 }
 
