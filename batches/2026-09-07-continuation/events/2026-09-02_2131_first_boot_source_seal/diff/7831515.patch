+func gatewayCaptureFunction(path string, function *ast.FuncDecl, method string) bool {
+	if function == nil || function.Name == nil || function.Body == nil {
+		return false
+	}
+	switch method {
+	case "ProduceCapture":
+		switch {
+		case strings.HasSuffix(path, "/cmd/gateway/bootstrap_capture.go"):
+			return function.Name.Name == "preCaptureSource" && function.Recv == nil
+		case strings.HasSuffix(path, "/cmd/gateway/bootstrap_source.go"):
+			return function.Name.Name == "capture" && initialCaptureReceiver(function)
+		default:
+			return false
+		}
+	case "ValidateWriterInventory":
+		return strings.HasSuffix(path, "/cmd/gateway/bootstrap_capture.go") && function.Name.Name == "finishPreCapture" && function.Recv == nil
+	default:
+		return false
+	}
+}
+
+func initialCaptureReceiver(function *ast.FuncDecl) bool {
+	if function.Recv == nil || len(function.Recv.List) != 1 {
+		return false
+	}
+	field := function.Recv.List[0]
+	if len(field.Names) != 1 || field.Names[0].Name != "c" {
+		return false
+	}
+	receiver, ok := field.Type.(*ast.Ident)
+	return ok && receiver.Name == "initialCapture"
+}
+
+func gatewayCaptureExact(pkg *packages.Package, path string, function *ast.FuncDecl, method string, selector *ast.SelectorExpr, call *ast.CallExpr, parent ast.Node) bool {
+	assignment, ok := parent.(*ast.AssignStmt)
+	if !ok || assignment.Tok != token.DEFINE {
+		return false
+	}
+	packageIdent, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return false
+	}
+	wantPackage := ""
+	wantArgs := []string{}
+	switch method {
+	case "ProduceCapture":
+		wantPackage = "intentinventory"
+		if strings.HasSuffix(path, "/cmd/gateway/bootstrap_capture.go") {
+			wantArgs = []string{"ctx", "before.MaterialPath"}
+		} else if strings.HasSuffix(path, "/cmd/gateway/bootstrap_source.go") {
+			wantArgs = []string{"ctx", "input.StagingPath"}
+		} else {
+			return false
+		}
+	case "ValidateWriterInventory":
+		wantPackage = "intentv1"
+		wantArgs = []string{"report.Inventory"}
+	default:
+		return false
+	}
+	if packageIdent.Name != wantPackage || len(call.Args) != len(wantArgs) {
+		return false
+	}
+	for index, want := range wantArgs {
+		if !sourceExpr(call.Args[index], want) {
+			return false
+		}
+	}
+	object := pkg.TypesInfo.Uses[selector.Sel]
+	if object == nil || object.Name() != method || object.Pkg() == nil || object.Parent() != object.Pkg().Scope() {
+		return false
+	}
+	if method == "ProduceCapture" && object.Pkg().Path() != producerPath {
+		return false
+	}
+	return method != "ValidateWriterInventory" || object.Pkg().Path() == inventoryPath
+}
+
