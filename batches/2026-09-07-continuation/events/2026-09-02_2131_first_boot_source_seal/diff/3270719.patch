+func TestSessionSupervisorPromotionFailures(t *testing.T) {
+	branchCause := errors.New("source branch unavailable")
+	registerCause := errors.New("source register unavailable")
+	readbackCause := errors.New("source readback unavailable")
+	renewCause := errors.New("final renew unavailable")
+	closeCause := errors.New("postcommit close unavailable")
+	cases := []struct {
+		name          string
+		initialResult []storeiface.InitialSourceBranchResultV1
+		initialErrors []error
+		ownerErr      error
+		renewErrors   []error
+		renewKinds    []storeiface.RuntimeSessionResultKind
+		cause         error
+		closeKind     storeiface.RuntimeSessionResultKind
+		closeErr      error
+	}{
+		{name: "branch", initialErrors: []error{branchCause}, cause: branchCause},
+		{name: "register", ownerErr: registerCause, cause: registerCause},
+		{name: "readback", initialErrors: []error{nil, readbackCause}, cause: readbackCause},
+		{name: "final renew", renewErrors: []error{nil, renewCause}, cause: renewCause},
+		{name: "final renew verdict", renewKinds: []storeiface.RuntimeSessionResultKind{"", storeiface.RuntimeSessionStale}},
+		{name: "final renew current", renewKinds: []storeiface.RuntimeSessionResultKind{"", storeiface.RuntimeSessionRenewed}},
+		{name: "postcommit stale close", ownerErr: registerCause, cause: registerCause, closeKind: storeiface.RuntimeSessionStale},
+		{name: "postcommit typed close", ownerErr: registerCause, cause: registerCause, closeErr: &storeiface.RuntimeSessionError{ErrorKind: storeiface.RuntimeSessionUnavailable, Cause: closeCause}},
+	}
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			lifecycle, cancel, start, spy, owner, manifest := promotionPrepared(t, false)
+			defer cancel()
+			if len(testCase.initialResult) != 0 {
+				spy.initialResults = testCase.initialResult
+			}
+			if len(testCase.initialErrors) != 0 {
+				spy.initialErrors = testCase.initialErrors
+			}
+			owner.err = testCase.ownerErr
+			spy.renewErrors = testCase.renewErrors
+			spy.renewKinds = testCase.renewKinds
+			spy.closeKind = testCase.closeKind
+			spy.closeErr = testCase.closeErr
+			wait, err := startSessionSupervisor(lifecycle, spy, start.process, owner, manifest, start.shutdownTimeout)
+			if wait != nil || err == nil || (testCase.cause != nil && !errors.Is(err, testCase.cause)) {
+				t.Fatalf("wait=%v err=%v cause=%v", wait, err, testCase.cause)
+			}
+			spy.mu.Lock()
+			renewCalls, closeCalls := spy.renewCalls, spy.closeCalls
+			transitions := append([]storeiface.RuntimeSessionRequest(nil), spy.transitionInputs...)
+			results := append([]storeiface.RuntimeSessionResult(nil), spy.transitionResults...)
+			spy.mu.Unlock()
+			if closeCalls != 1 || len(transitions) == 0 || transitions[len(transitions)-1].Action != storeiface.RuntimeSessionClose {
+				t.Fatalf("renew=%d close=%d transitions=%d", renewCalls, closeCalls, len(transitions))
+			}
+			if len(results) == 0 || transitions[len(transitions)-1].Current != results[0].Current {
+				t.Fatal("failure close did not use the last confirmed current")
+			}
+			if strings.HasPrefix(testCase.name, "final renew") && renewCalls != 2 {
+				t.Fatalf("final renew calls=%d want=2", renewCalls)
+			}
+			if testCase.closeKind != "" && !strings.Contains(err.Error(), string(testCase.closeKind)) {
+				t.Fatalf("close verdict=%v want=%s", err, testCase.closeKind)
+			}
+			if testCase.closeErr != nil {
+				var typed *storeiface.RuntimeSessionError
+				if !errors.As(err, &typed) || !errors.Is(err, closeCause) || typed.Kind() != storeiface.RuntimeSessionUnavailable {
+					t.Fatalf("close uncertainty=%v typed=%v", err, typed)
+				}
+			}
+		})
+	}
+}
