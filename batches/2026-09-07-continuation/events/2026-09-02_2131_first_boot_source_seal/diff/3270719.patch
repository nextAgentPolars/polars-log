+
+func (c initialCapture) capture(ctx context.Context, input sourceowner.InitialCaptureInput) (sourceowner.SourceCaptureV1, error) {
+	if ctx == nil {
+		return sourceowner.SourceCaptureV1{}, fmt.Errorf("initial source capture context is nil")
+	}
+	if err := ctx.Err(); err != nil {
+		return sourceowner.SourceCaptureV1{}, err
+	}
+	report, err := intentinventory.ProduceCapture(ctx, input.StagingPath)
+	if err != nil {
+		return sourceowner.SourceCaptureV1{}, fmt.Errorf("initial source capture: %w", err)
+	}
+	if report.WorldDigest != c.report.WorldDigest || !reflect.DeepEqual(report.Inventory, c.report.Inventory) {
+		return sourceowner.SourceCaptureV1{}, fmt.Errorf("initial source capture differs from pre-capture")
+	}
+	captured, err := sourcecapture.BuildCapture(report, input.QuiescenceRef)
+	if err != nil {
+		return sourceowner.SourceCaptureV1{}, fmt.Errorf("initial source capture build: %w", err)
+	}
+	return captured, nil
+}
+
+func copyReport(report intentinventory.CaptureReportV1) intentinventory.CaptureReportV1 {
+	report.Inventory.StateRefs = append([]string(nil), report.Inventory.StateRefs...)
+	report.Inventory.SourceRefs = append([]string(nil), report.Inventory.SourceRefs...)
+	return report
+}
+
+func promoteSource(start sessionStart, current0 storeiface.RuntimeSessionSnapshotV1) error {
+	pre := start.process.Lease.PreCapture
+	lookup := storeiface.SourceAuthorityLookupV1{StoreRef: pre.Source.Ingress.StoreRef}
+	branch, err := start.store.InspectInitialSourceBranch(start.lifecycle, lookup)
+	if err != nil {
+		return fmt.Errorf("gateway source promotion branch: %w", err)
+	}
+	if branch != pre.Source.Branch {
+		return fmt.Errorf("gateway source promotion branch differs from pre-capture")
+	}
+	switch branch.Kind {
+	case storeiface.InitialSourceBranchFirstBootV1:
+		if branch.Current != (storeiface.SourceAuthorityCurrentV1{}) {
+			return fmt.Errorf("gateway source promotion first boot current is not zero")
+		}
+		preReport := copyReport(pre.Report)
+		capture := initialCapture{report: preReport}
+		input := sourceowner.SourceBootstrap{
+			StoreRef:   pre.Source.Ingress.StoreRef,
+			WriterRef:  current0.Lease.OwnerRef,
+			Lease:      current0.Lease,
+			Lifecycle:  current0.LeaseLifecycle,
+			SourceRoot: pre.Source.MaterialPath,
+			Capture:    capture.capture,
+		}
+		registered, err := start.owner.RegisterInitialCandidate(start.lifecycle, input)
+		if err != nil {
+			return fmt.Errorf("gateway source promotion register: %w", err)
+		}
+		after, err := start.store.InspectInitialSourceBranch(start.lifecycle, lookup)
+		if err != nil {
+			return fmt.Errorf("gateway source promotion readback: %w", err)
+		}
+		want := storeiface.InitialSourceBranchResultV1{
+			Kind:    storeiface.InitialSourceBranchRestartDurableV1,
+			Current: registered,
+		}
+		if after != want {
+			return fmt.Errorf("gateway source promotion readback differs")
+		}
+	case storeiface.InitialSourceBranchRestartDurableV1:
+		if !strictCurrent(branch.Current) {
+			return fmt.Errorf("gateway source promotion restart current is invalid")
+		}
+	default:
+		return fmt.Errorf("gateway source promotion branch is closed")
+	}
+	return nil
+}
