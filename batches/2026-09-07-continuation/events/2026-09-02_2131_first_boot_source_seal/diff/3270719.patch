+func promotionPrepared(t *testing.T, restart bool) (context.Context, context.CancelFunc, sessionStart, *sessionStoreSpy, *promotionOwnerFake, config.RuntimeManifestV1) {
+	t.Helper()
+	process, manifest, record := syntheticProcess(t)
+	first := process.Lease.PreCapture.Source.Branch
+	owner := &promotionOwnerFake{result: promotionCurrent(process.Lease.Lease.Lease.StoreRef)}
+	if restart {
+		current := promotionCurrent(process.Lease.Lease.Lease.StoreRef)
+		first = storeiface.InitialSourceBranchResultV1{
+			Kind:    storeiface.InitialSourceBranchRestartDurableV1,
+			Current: current,
+		}
+		process.Lease.PreCapture.Source.Branch = first
+	} else {
+		first = storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchFirstBootV1}
+		process.Lease.PreCapture.Source.Branch = first
+	}
+	base := &sessionAuthorityFake{record: record}
+	spy := &sessionStoreSpy{
+		base:           base,
+		transitionDone: make(chan struct{}, 8),
+		publishRecord:  record,
+		resolveRecord:  record,
+		initialResults: []storeiface.InitialSourceBranchResultV1{first},
+	}
+	if !restart {
+		spy.initialResults = append(spy.initialResults, storeiface.InitialSourceBranchResultV1{
+			Kind:    storeiface.InitialSourceBranchRestartDurableV1,
+			Current: owner.result,
+		})
+	}
+	lifecycle, cancel := context.WithCancel(context.Background())
+	start, err := prepareSession(lifecycle, spy, process, owner, manifest, time.Second)
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	return lifecycle, cancel, start, spy, owner, manifest
+}
