+func TestSessionSupervisorPromotion(t *testing.T) {
+	for _, restart := range []bool{false, true} {
+		name := "first boot"
+		if restart {
+			name = "restart"
+		}
+		t.Run(name, func(t *testing.T) {
+			lifecycle, cancel, start, spy, owner, manifest := promotionPrepared(t, restart)
+			wait, err := startSessionSupervisor(lifecycle, spy, start.process, owner, manifest, start.shutdownTimeout)
+			if err != nil || wait == nil {
+				t.Fatalf("wait=%v err=%v", wait, err)
+			}
+			spy.mu.Lock()
+			transitions := append([]storeiface.RuntimeSessionRequest(nil), spy.transitionInputs...)
+			results := append([]storeiface.RuntimeSessionResult(nil), spy.transitionResults...)
+			initialCalls := spy.initialCalls
+			renewCalls, closeCalls := spy.renewCalls, spy.closeCalls
+			spy.mu.Unlock()
+			if restart {
+				if owner.calls != 0 || initialCalls != 1 {
+					t.Fatalf("restart owner calls=%d initial calls=%d", owner.calls, initialCalls)
+				}
+			} else if owner.calls != 1 || initialCalls != 2 || owner.input.Capture == nil || owner.input.SourceRoot != start.process.Lease.PreCapture.Source.MaterialPath {
+				t.Fatalf("first boot owner calls=%d initial calls=%d capture=%v", owner.calls, initialCalls, owner.input.Capture != nil)
+			}
+			if renewCalls != 2 || closeCalls != 0 || len(transitions) != 2 || len(results) != 2 {
+				t.Fatalf("before close renew=%d close=%d transitions=%d results=%d", renewCalls, closeCalls, len(transitions), len(results))
+			}
+			if !restart {
+				current0 := results[0].Current
+				if owner.input.Lease != current0.Lease || owner.input.Lifecycle != current0.LeaseLifecycle || owner.input.StoreRef != current0.Lease.StoreRef || owner.input.WriterRef != current0.Lease.OwnerRef {
+					t.Fatal("FirstBoot SourceBootstrap did not use exact current0")
+				}
+			}
+			cancel()
+			if err := wait.wait(); err != nil {
+				t.Fatal(err)
+			}
+			spy.mu.Lock()
+			closeCalls = spy.closeCalls
+			transitions = append([]storeiface.RuntimeSessionRequest(nil), spy.transitionInputs...)
+			spy.mu.Unlock()
+			if closeCalls != 1 || len(transitions) != 3 || transitions[2].Action != storeiface.RuntimeSessionClose || transitions[2].Current != results[1].Current {
+				t.Fatalf("after close close=%d transitions=%d", closeCalls, len(transitions))
+			}
+		})
+	}
+}
