+func TestSessionSupervisorLaunchCurrentStatic(t *testing.T) {
+	_, testFile, _, ok := stdruntime.Caller(0)
+	if !ok {
+		t.Fatal("runtime caller unavailable")
+	}
+	root := filepath.Dir(filepath.Dir(filepath.Dir(testFile)))
+	path := filepath.Join(root, "cmd", "gateway", "session_supervisor.go")
+	source, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	set := token.NewFileSet()
+	file, err := parser.ParseFile(set, path, source, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	launchCount := 0
+	current0Aborts, current1Aborts := 0, 0
+	var launchCall, abortCall *ast.CallExpr
+	for _, declaration := range file.Decls {
+		function, ok := declaration.(*ast.FuncDecl)
+		if !ok || function.Name == nil || function.Name.Name != "startSessionSupervisor" || function.Body == nil {
+			continue
+		}
+		for index, statement := range function.Body.List {
+			assign, ok := statement.(*ast.AssignStmt)
+			if !ok || assign.Tok != token.DEFINE || len(assign.Lhs) != 2 || len(assign.Rhs) != 1 {
+				continue
+			}
+			left, leftOK := assign.Lhs[0].(*ast.Ident)
+			right, rightOK := assign.Lhs[1].(*ast.Ident)
+			call, callOK := assign.Rhs[0].(*ast.CallExpr)
+			var callee *ast.Ident
+			calleeOK := false
+			if callOK {
+				callee, calleeOK = call.Fun.(*ast.Ident)
+			}
+			if !leftOK || left.Name != "wait" || !rightOK || right.Name != "err" || !callOK || !calleeOK || callee.Name != "launchSession" {
+				continue
+			}
+			launchCount++
+			if launchCount != 1 {
+				t.Fatal("second launchSession assignment")
+			}
+			launchCall = call
+			want := []string{"start", "current1", "nil"}
+			if len(call.Args) != len(want) {
+				t.Fatalf("launchSession args=%d want=%d", len(call.Args), len(want))
+			}
+			for argIndex, argument := range call.Args {
+				ident, ok := argument.(*ast.Ident)
+				if !ok || ident.Name != want[argIndex] {
+					t.Fatalf("launchSession arg%d changed", argIndex)
+				}
+			}
+			if index+1 >= len(function.Body.List) {
+				t.Fatal("launchSession is missing its immediate error guard")
+			}
+			guard, ok := function.Body.List[index+1].(*ast.IfStmt)
+			if !ok || guard.Init != nil || guard.Cond == nil || guard.Body == nil || len(guard.Body.List) != 1 {
+				t.Fatal("launchSession immediate error guard changed")
+			}
+			condition, ok := guard.Cond.(*ast.BinaryExpr)
+			leftCond, leftOK := condition.X.(*ast.Ident)
+			rightCond, rightOK := condition.Y.(*ast.Ident)
+			if !ok || condition.Op != token.NEQ || !leftOK || leftCond.Name != "err" || !rightOK || rightCond.Name != "nil" {
+				t.Fatal("launchSession guard condition changed")
+			}
+			result, ok := guard.Body.List[0].(*ast.ReturnStmt)
+			if !ok || len(result.Results) != 2 || !sourceExpr(result.Results[0], "nil") {
+				t.Fatal("launchSession guard return changed")
+			}
+			guardCall, ok := result.Results[1].(*ast.CallExpr)
+			var guardCallee *ast.Ident
+			calleeOK = false
+			if ok {
+				guardCallee, calleeOK = guardCall.Fun.(*ast.Ident)
+			}
+			if !ok || !calleeOK || guardCallee.Name != "abortSession" || len(guardCall.Args) != 3 || !sourceExpr(guardCall.Args[0], "start") || !sourceExpr(guardCall.Args[1], "current1") || !sourceExpr(guardCall.Args[2], "err") {
+				t.Fatal("launchSession failure path changed")
+			}
+			abortCall = guardCall
+		}
+		allowedAbort := map[*ast.Ident]bool{}
+		ast.Inspect(function.Body, func(node ast.Node) bool {
+			switch value := node.(type) {
+			case *ast.CallExpr:
+				callee, ok := value.Fun.(*ast.Ident)
+				if ok && callee.Name == "launchSession" {
+					if value != launchCall {
+						t.Fatal("second or indirect launchSession call")
+					}
+				}
+				if ok && callee.Name == "abortSession" {
+					allowedAbort[callee] = true
+					if len(value.Args) != 3 || !sourceExpr(value.Args[0], "start") {
+						t.Fatal("abortSession receiver or arity changed")
+					}
+					switch {
+					case sourceExpr(value.Args[1], "current1"):
+						current1Aborts++
+						if value != abortCall || !sourceExpr(value.Args[2], "err") {
+							t.Fatal("current1 abortSession path changed")
+						}
+					case sourceExpr(value.Args[1], "current0"):
+						current0Aborts++
+						if !sourceExpr(value.Args[2], "err") && !sourceExpr(value.Args[2], "cause") {
+							t.Fatal("current0 abortSession cause changed")
+						}
+					default:
+						t.Fatal("abortSession used an old or inferred current")
+					}
+				}
+			case *ast.Ident:
+				if value.Name == "launchSession" && launchCall != nil {
+					callee, ok := launchCall.Fun.(*ast.Ident)
+					if !ok || value != callee {
+						t.Fatal("launchSession escaped as alias")
+					}
+				}
+				if value.Name == "abortSession" && !allowedAbort[value] {
+					t.Fatal("abortSession escaped as alias")
+				}
+			case *ast.SelectorExpr:
+				if value.Sel.Name == "launchSession" || value.Sel.Name == "abortSession" {
+					t.Fatal("launch or abort escaped through selector")
+				}
+			}
+			return true
+		})
+	}
+	if launchCount != 1 || current0Aborts != 4 || current1Aborts != 1 || launchCall == nil || abortCall == nil {
+		t.Fatalf("startSessionSupervisor launch=%d abort-current0=%d abort-current1=%d want=1/4/1", launchCount, current0Aborts, current1Aborts)
+	}
+}
