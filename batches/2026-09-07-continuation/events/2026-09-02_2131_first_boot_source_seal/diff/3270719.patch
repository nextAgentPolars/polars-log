+const (
+	viewMaxFiles = 20000
+	viewMaxDirs  = 20000
+	viewMaxDepth = 64
+	viewMaxBytes = int64(128 << 20)
+	viewMaxFile  = int64(8 << 20)
+)
+
+type sourceViewBudget struct {
+	files int
+	dirs  int
+	bytes int64
+}
+
+func copySourceView(t *testing.T, sourceRoot, viewRoot string) error {
+	t.Helper()
+	if sourceRoot == "" || !filepath.IsAbs(sourceRoot) || filepath.Clean(sourceRoot) != sourceRoot {
+		return fmt.Errorf("source view root is not absolute and clean")
+	}
+	if viewRoot == "" || !filepath.IsAbs(viewRoot) || filepath.Clean(viewRoot) != viewRoot {
+		return fmt.Errorf("source view destination is not absolute and clean")
+	}
+	sourceInfo, err := os.Lstat(sourceRoot)
+	if err != nil {
+		return err
+	}
+	if sourceInfo.Mode()&os.ModeSymlink != 0 || !sourceInfo.IsDir() {
+		return fmt.Errorf("source view root is not a directory")
+	}
+	if _, err := os.Lstat(viewRoot); err == nil {
+		return fmt.Errorf("source view destination already exists")
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := os.Mkdir(viewRoot, 0o700); err != nil {
+		return err
+	}
+	copyBudget := sourceViewBudget{}
+	if err := copyViewTree(sourceRoot, viewRoot, 0, true, &copyBudget); err != nil {
+		return err
+	}
+	verifyBudget := sourceViewBudget{}
+	return verifyViewTree(sourceRoot, viewRoot, 0, true, &verifyBudget)
+}
+
+func copyViewTree(source, target string, depth int, root bool, budget *sourceViewBudget) error {
+	if budget == nil {
+		return fmt.Errorf("source view budget is nil")
+	}
+	if depth > viewMaxDepth {
+		return fmt.Errorf("source view depth budget exceeded")
+	}
+	if budget.dirs >= viewMaxDirs {
+		return fmt.Errorf("source view directory budget exceeded")
+	}
+	budget.dirs++
+	entries, err := os.ReadDir(source)
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		sourcePath := filepath.Join(source, name)
+		info, err := os.Lstat(sourcePath)
+		if err != nil {
+			return err
+		}
+		if skipView(name, info, root) {
+			continue
+		}
+		targetPath := filepath.Join(target, name)
+		if info.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("source view symlink is not allowed: %s", sourcePath)
+		}
+		if info.IsDir() {
+			if err := os.Mkdir(targetPath, 0o700); err != nil {
+				return err
+			}
+			if err := copyViewTree(sourcePath, targetPath, depth+1, false, budget); err != nil {
+				return err
+			}
+			continue
+		}
+		if !info.Mode().IsRegular() {
+			return fmt.Errorf("source view special entry is not allowed: %s", sourcePath)
+		}
+		if err := addViewFile(info.Size(), budget); err != nil {
+			return fmt.Errorf("%s: %w", sourcePath, err)
+		}
+		if err := copyViewFile(sourcePath, targetPath, info.Size()); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func verifyViewTree(source, target string, depth int, root bool, budget *sourceViewBudget) error {
+	if budget == nil {
+		return fmt.Errorf("source view budget is nil")
+	}
+	if depth > viewMaxDepth {
+		return fmt.Errorf("source view depth budget exceeded")
+	}
+	if budget.dirs >= viewMaxDirs {
+		return fmt.Errorf("source view directory budget exceeded")
+	}
+	budget.dirs++
+	sourceEntries, err := os.ReadDir(source)
+	if err != nil {
+		return err
+	}
+	targetEntries, err := os.ReadDir(target)
+	if err != nil {
+		return err
+	}
+	remaining := make(map[string]struct{}, len(targetEntries))
+	for _, entry := range targetEntries {
+		remaining[entry.Name()] = struct{}{}
+	}
+	for _, entry := range sourceEntries {
+		name := entry.Name()
+		sourcePath := filepath.Join(source, name)
+		info, err := os.Lstat(sourcePath)
+		if err != nil {
+			return err
+		}
+		if skipView(name, info, root) {
+			if _, found := remaining[name]; found {
+				return fmt.Errorf("excluded source view entry was copied: %s", name)
+			}
+			continue
+		}
+		if _, found := remaining[name]; !found {
+			return fmt.Errorf("source view path missing: %s", sourcePath)
+		}
+		delete(remaining, name)
+		targetPath := filepath.Join(target, name)
+		targetInfo, err := os.Lstat(targetPath)
+		if err != nil {
+			return err
+		}
+		if info.Mode()&os.ModeSymlink != 0 || targetInfo.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("source view symlink is not allowed: %s", sourcePath)
+		}
+		if info.IsDir() {
+			if !targetInfo.IsDir() {
+				return fmt.Errorf("source view kind differs: %s", sourcePath)
+			}
+			if err := verifyViewTree(sourcePath, targetPath, depth+1, false, budget); err != nil {
+				return err
+			}
+			continue
+		}
+		if !info.Mode().IsRegular() || !targetInfo.Mode().IsRegular() {
+			return fmt.Errorf("source view special entry is not allowed: %s", sourcePath)
+		}
+		if err := addViewFile(info.Size(), budget); err != nil {
+			return fmt.Errorf("%s: %w", sourcePath, err)
+		}
+		if targetInfo.Size() != info.Size() {
+			return fmt.Errorf("source view byte length differs: %s", sourcePath)
+		}
+		if err := compareViewFiles(sourcePath, targetPath, info.Size()); err != nil {
+			return err
+		}
+	}
+	if len(remaining) != 0 {
+		for name := range remaining {
+			return fmt.Errorf("source view has extra path: %s", filepath.Join(target, name))
+		}
+	}
+	return nil
+}
+
+func skipView(name string, info os.FileInfo, root bool) bool {
+	if info == nil || !info.IsDir() {
+		return false
+	}
+	return name == ".git" || root && name == "bin"
+}
+
+func addViewFile(size int64, budget *sourceViewBudget) error {
+	if size < 0 || size > viewMaxFile || budget.files >= viewMaxFiles || budget.bytes > viewMaxBytes-size {
+		return fmt.Errorf("source view file budget exceeded")
+	}
+	budget.files++
+	budget.bytes += size
+	return nil
+}
+
+func copyViewFile(source, target string, want int64) error {
+	input, err := os.Open(source)
+	if err != nil {
+		return err
+	}
+	output, err := os.OpenFile(target, os.O_CREATE|os.O_WRONLY|os.O_EXCL, 0o600)
+	if err != nil {
+		return errors.Join(err, input.Close())
+	}
+	written, copyErr := io.Copy(output, io.LimitReader(input, viewMaxFile+1))
+	closeOut := output.Close()
+	closeIn := input.Close()
+	if err := errors.Join(copyErr, closeOut, closeIn); err != nil {
+		return err
+	}
+	if written > viewMaxFile || written != want {
+		return fmt.Errorf("source view file changed while copying: %s", source)
+	}
+	return nil
+}
+
+func compareViewFiles(source, target string, want int64) error {
+	left, err := os.Open(source)
+	if err != nil {
+		return err
+	}
+	right, err := os.Open(target)
+	if err != nil {
+		return errors.Join(err, left.Close())
+	}
+	leftReader := io.LimitReader(left, viewMaxFile+1)
+	rightReader := io.LimitReader(right, viewMaxFile+1)
+	leftBuffer := make([]byte, 32*1024)
+	rightBuffer := make([]byte, 32*1024)
+	var compared int64
+	var compareErr error
+	for compareErr == nil {
+		leftN, leftErr := leftReader.Read(leftBuffer)
+		rightN, rightErr := rightReader.Read(rightBuffer)
+		if leftN != rightN || !bytes.Equal(leftBuffer[:leftN], rightBuffer[:rightN]) {
+			compareErr = fmt.Errorf("source view file bytes differ: %s", source)
+			break
+		}
+		compared += int64(leftN)
+		if compared > viewMaxFile {
+			compareErr = fmt.Errorf("source view file budget exceeded: %s", source)
+			break
+		}
+		leftEOF := errors.Is(leftErr, io.EOF)
+		rightEOF := errors.Is(rightErr, io.EOF)
+		if leftEOF || rightEOF {
+			if !leftEOF || !rightEOF {
+				compareErr = fmt.Errorf("source view file length differs: %s", source)
+			}
+			break
+		}
+		if leftErr != nil || rightErr != nil {
+			compareErr = errors.Join(leftErr, rightErr)
+			break
+		}
+	}
+	if compareErr == nil && compared != want {
+		compareErr = fmt.Errorf("source view file length differs: %s", source)
+	}
+	closeLeft := left.Close()
+	closeRight := right.Close()
+	return errors.Join(compareErr, closeLeft, closeRight)
+}
+
+const cleanupMaxDirs = 100000
+
+func cleanColdRoot(root string) error {
+	if root == "" || !filepath.IsAbs(root) || filepath.Clean(root) != root {
+		return fmt.Errorf("cold root is not absolute and clean")
+	}
+	var failures []error
+	dirs := 0
+	walkErr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			addFailure(&failures, fmt.Errorf("walk cold root %s: %w", path, err))
+			return nil
+		}
+		if entry == nil {
+			addFailure(&failures, fmt.Errorf("walk cold root %s: missing entry", path))
+			return nil
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			addFailure(&failures, fmt.Errorf("cold root symlink is not allowed: %s", path))
+			return nil
+		}
+		if entry.IsDir() {
+			dirs++
+			if dirs > cleanupMaxDirs {
+				addFailure(&failures, fmt.Errorf("cold root directory budget exceeded: %s", path))
+				return filepath.SkipDir
+			}
+			if err := os.Chmod(path, 0o700); err != nil {
+				addFailure(&failures, fmt.Errorf("chmod cold root directory %s: %w", path, err))
+			}
+			return nil
+		}
+		if !entry.Type().IsRegular() {
+			addFailure(&failures, fmt.Errorf("cold root special entry is not allowed: %s", path))
+		}
+		return nil
+	})
+	addFailure(&failures, walkErr)
+	removeErr := os.RemoveAll(root)
+	return errors.Join(append(failures, removeErr)...)
+}
+
+func addFailure(failures *[]error, err error) {
+	if failures == nil || err == nil {
+		return
+	}
+	*failures = append(*failures, err)
+}
