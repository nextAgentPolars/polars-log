diff --git a/internal/runtime/source/owner_material.go b/internal/runtime/source/owner_material.go
new file mode 100644
index 0000000..736b321
--- /dev/null
+++ b/internal/runtime/source/owner_material.go
@@ -0,0 +1,175 @@
+package source
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	storeiface "polaris/internal/store"
+)
+
+// CandidateMaterialV1 carries one call-time verified path and supplied current.
+// It does not prove durable origin, currentness, or post-return stability.
+type CandidateMaterialV1 struct {
+	Current       storeiface.SourceAuthorityCurrentV1
+	CandidatePath string
+}
+
+func materialFailure(cause error) (CandidateMaterialV1, error) {
+	if cause == nil {
+		cause = sourceError("source_authority_unavailable", fmt.Errorf("candidate material failed without a cause"))
+	}
+	return CandidateMaterialV1{}, cause
+}
+
+type materialSnapshot struct {
+	rootPath      string
+	candidateDir  string
+	candidatePath string
+	root          *os.File
+	candidates    *os.File
+	candidate     *os.File
+	rootInfo      os.FileInfo
+	candidateInfo os.FileInfo
+	materialInfo  os.FileInfo
+}
+
+// InspectCandidateMaterial checks one supplied RestartDurable relationship
+// without changing source authority state.
+func (o *Owner) InspectCandidateMaterial(ctx context.Context, branch storeiface.InitialSourceBranchResultV1) (CandidateMaterialV1, error) {
+	if ctx == nil {
+		return materialFailure(sourceError("source_input_invalid", fmt.Errorf("context is nil")))
+	}
+	if branch.Kind != storeiface.InitialSourceBranchRestartDurableV1 {
+		return materialFailure(sourceError("source_input_invalid", fmt.Errorf("initial source branch is not restart durable")))
+	}
+	current := branch.Current
+	if current.CandidateRef == "" || current.RootDigest == "" || !strictDigest(current.CandidateRef) || !strictDigest(current.RootDigest) || current.CandidateRef != current.RootDigest {
+		return materialFailure(sourceError("source_input_invalid", fmt.Errorf("candidate and root digests are invalid")))
+	}
+	if o == nil {
+		return materialFailure(sourceError("source_authority_unavailable", fmt.Errorf("source owner is unavailable")))
+	}
+	if err := ctx.Err(); err != nil {
+		return materialFailure(sourceError("source_authority_unavailable", err))
+	}
+	pre, err := o.openMaterial(current.CandidateRef)
+	if err != nil {
+		return materialFailure(err)
+	}
+	verified, verifyErr := o.verifyCandidate(current.CandidateRef, current.RootDigest)
+	if verifyErr != nil {
+		return materialFailure(closeMaterial(pre, verifyErr))
+	}
+	if err := ctx.Err(); err != nil {
+		return materialFailure(closeMaterial(pre, sourceError("source_authority_unavailable", err)))
+	}
+	post, err := o.openMaterial(current.CandidateRef)
+	if err != nil {
+		return materialFailure(closeMaterial(pre, err))
+	}
+	identityOK := sameMaterial(pre, post)
+	if err := ctx.Err(); err != nil {
+		return materialFailure(closeMaterial(pre, closeMaterial(post, sourceError("source_authority_unavailable", err))))
+	}
+	if !identityOK {
+		return materialFailure(closeMaterial(pre, closeMaterial(post, sourceError("source_authority_corrupt", fmt.Errorf("candidate material identity changed")))))
+	}
+	if err := closeMaterial(pre, nil); err != nil {
+		return materialFailure(closeMaterial(post, err))
+	}
+	if err := closeMaterial(post, nil); err != nil {
+		return materialFailure(sourceError("source_authority_unavailable", err))
+	}
+	return CandidateMaterialV1{Current: current, CandidatePath: verified}, nil
+}
+
+func (o *Owner) openMaterial(ref string) (*materialSnapshot, error) {
+	target, err := o.candidateTarget(ref)
+	if err != nil {
+		return nil, err
+	}
+	root := filepath.Dir(filepath.Dir(target))
+	candidates := filepath.Dir(target)
+	return openHandles(root, candidates, target)
+}
+
+func materialOpenError(cause error) error {
+	var typed *sourceMutationError
+	if errors.As(cause, &typed) {
+		return cause
+	}
+	return sourceError("source_authority_unavailable", cause)
+}
+
+func openHandles(root, candidates, candidate string) (*materialSnapshot, error) {
+	snapshot := &materialSnapshot{rootPath: root, candidateDir: candidates, candidatePath: candidate}
+	var err error
+	snapshot.root, err = openMaterialDir(root)
+	if err != nil {
+		return nil, materialOpenError(err)
+	}
+	snapshot.rootInfo, err = snapshot.root.Stat()
+	if err != nil {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_unavailable", err))
+	}
+	snapshot.candidates, err = openMaterialDir(candidates)
+	if err != nil {
+		return nil, closeMaterial(snapshot, materialOpenError(err))
+	}
+	snapshot.candidateInfo, err = snapshot.candidates.Stat()
+	if err != nil {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_unavailable", err))
+	}
+	leafInfo, err := os.Lstat(candidate)
+	if err != nil {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_unavailable", err))
+	}
+	if leafInfo.Mode()&os.ModeSymlink != 0 || !leafInfo.IsDir() {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_corrupt", fmt.Errorf("candidate path is not a directory")))
+	}
+	snapshot.candidate, err = openMaterialDir(candidate)
+	if err != nil {
+		return nil, closeMaterial(snapshot, materialOpenError(err))
+	}
+	snapshot.materialInfo, err = snapshot.candidate.Stat()
+	if err != nil {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_unavailable", err))
+	}
+	if snapshot.rootInfo.Mode()&os.ModeSymlink != 0 || snapshot.candidateInfo.Mode()&os.ModeSymlink != 0 || snapshot.materialInfo.Mode()&os.ModeSymlink != 0 || !snapshot.rootInfo.IsDir() || !snapshot.candidateInfo.IsDir() || !snapshot.materialInfo.IsDir() {
+		return nil, closeMaterial(snapshot, sourceError("source_authority_corrupt", fmt.Errorf("material path is not a directory")))
+	}
+	return snapshot, nil
+}
+
+func closeHandle(handle **os.File) error {
+	if handle == nil || *handle == nil {
+		return nil
+	}
+	file := *handle
+	*handle = nil
+	return file.Close()
+}
+
+func closeMaterial(snapshot *materialSnapshot, cause error) error {
+	if snapshot == nil {
+		return cause
+	}
+	closeErr := errors.Join(closeHandle(&snapshot.root), closeHandle(&snapshot.candidates), closeHandle(&snapshot.candidate))
+	if closeErr == nil {
+		return cause
+	}
+	if cause == nil {
+		return sourceError("source_authority_unavailable", closeErr)
+	}
+	return sourceError("source_authority_unavailable", errors.Join(cause, closeErr))
+}
+
+func sameMaterial(left, right *materialSnapshot) bool {
+	if left == nil || right == nil || left.rootPath != right.rootPath || left.candidateDir != right.candidateDir || left.candidatePath != right.candidatePath {
+		return false
+	}
+	return os.SameFile(left.rootInfo, right.rootInfo) && os.SameFile(left.candidateInfo, right.candidateInfo) && os.SameFile(left.materialInfo, right.materialInfo)
+}
diff --git a/internal/runtime/source/owner_material_open_unix.go b/internal/runtime/source/owner_material_open_unix.go
new file mode 100644
index 0000000..9cb7510
--- /dev/null
+++ b/internal/runtime/source/owner_material_open_unix.go
@@ -0,0 +1,27 @@
+//go:build !windows
+
+package source
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+func openMaterialDir(path string) (*os.File, error) {
+	flags := unix.O_RDONLY | unix.O_CLOEXEC | unix.O_DIRECTORY | unix.O_NOFOLLOW | unix.O_NONBLOCK
+	fd, err := unix.Open(path, flags, 0)
+	if err != nil {
+		if errors.Is(err, unix.ELOOP) || errors.Is(err, unix.ENOTDIR) {
+			return nil, sourceError("source_authority_corrupt", err)
+		}
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	if file != nil {
+		return file, nil
+	}
+	return nil, errors.Join(fmt.Errorf("material directory handle is unavailable"), unix.Close(fd))
+}
diff --git a/internal/runtime/source/owner_material_open_windows.go b/internal/runtime/source/owner_material_open_windows.go
new file mode 100644
index 0000000..0c8fa69
--- /dev/null
+++ b/internal/runtime/source/owner_material_open_windows.go
@@ -0,0 +1,25 @@
+//go:build windows
+
+package source
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/windows"
+)
+
+func openMaterialDir(path string) (*os.File, error) {
+	share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE | windows.FILE_SHARE_DELETE)
+	flags := uint32(windows.FILE_FLAG_BACKUP_SEMANTICS | windows.FILE_FLAG_OPEN_REPARSE_POINT)
+	handle, err := windows.CreateFile(windows.StringToUTF16Ptr(path), 0, share, nil, windows.OPEN_EXISTING, flags, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(handle), path)
+	if file != nil {
+		return file, nil
+	}
+	return nil, errors.Join(fmt.Errorf("material directory handle is unavailable"), windows.CloseHandle(handle))
+}
