+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		channel <- outcome{result: result, err: err}
+	}()
+	select {
+	case got := <-channel:
+		assertMaterialError(t, got.err, "source_authority_corrupt")
+		if got.result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", got.result)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("FIFO admission blocked")
+	}
+}
