+func unwrapUint32(expression ast.Expr) ast.Expr {
+	call, ok := expression.(*ast.CallExpr)
+	if !ok || len(call.Args) != 1 || !isName(call.Fun, "uint32") {
+		return nil
+	}
+	return call.Args[0]
+}
+
+func isSelector(expression ast.Expr, object, name string) bool {
+	selector, ok := expression.(*ast.SelectorExpr)
+	if !ok {
+		return false
+	}
+	return isName(selector.X, object) && selector.Sel.Name == name
+}
