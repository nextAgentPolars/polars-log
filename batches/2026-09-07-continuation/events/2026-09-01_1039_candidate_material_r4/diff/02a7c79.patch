+
+func calledName(call *ast.CallExpr, name string) bool {
+	switch function := call.Fun.(type) {
+	case *ast.Ident:
+		return function.Name == name
+	case *ast.SelectorExpr:
+		return function.Sel.Name == name
+	default:
+		return false
+	}
+}
+
+func topMaterialAssign(body []ast.Stmt, name string) int {
+	for index, statement := range body {
+		assignment, ok := statement.(*ast.AssignStmt)
+		if !ok || len(assignment.Lhs) != 2 || len(assignment.Rhs) != 1 || !isName(assignment.Lhs[0], name) {
+			continue
+		}
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		if !ok || !calledExpr(call.Fun, "openMaterial") || len(call.Args) != 1 {
+			continue
+		}
+		argument, ok := call.Args[0].(*ast.SelectorExpr)
+		if ok && isName(argument.X, "current") && argument.Sel.Name == "CandidateRef" {
+			return index
+		}
+	}
+	return -1
+}
+
+func topVerifyAssign(body []ast.Stmt) int {
+	for index, statement := range body {
+		assignment, ok := statement.(*ast.AssignStmt)
+		if !ok || len(assignment.Lhs) != 2 || len(assignment.Rhs) != 1 || !isName(assignment.Lhs[0], "verified") {
+			continue
+		}
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		if !ok || !calledExpr(call.Fun, "verifyCandidate") || len(call.Args) != 2 {
+			continue
+		}
+		first, firstOK := call.Args[0].(*ast.SelectorExpr)
+		second, secondOK := call.Args[1].(*ast.SelectorExpr)
+		if firstOK && secondOK && isName(first.X, "current") && first.Sel.Name == "CandidateRef" && isName(second.X, "current") && second.Sel.Name == "RootDigest" {
+			return index
+		}
+	}
+	return -1
+}
+
+func topIdentityAssign(body []ast.Stmt) int {
+	for index, statement := range body {
+		assignment, ok := statement.(*ast.AssignStmt)
+		if !ok || len(assignment.Lhs) != 1 || len(assignment.Rhs) != 1 || !isName(assignment.Lhs[0], "identityOK") {
+			continue
+		}
+		call, ok := assignment.Rhs[0].(*ast.CallExpr)
+		if ok && calledExpr(call.Fun, "sameMaterial") && len(call.Args) == 2 && isName(call.Args[0], "pre") && isName(call.Args[1], "post") {
+			return index
+		}
+	}
+	return -1
+}
+
+func materialContextGuard(statement ast.Stmt) bool {
+	guard, ok := statement.(*ast.IfStmt)
+	if !ok {
+		return false
+	}
+	assignment, ok := guard.Init.(*ast.AssignStmt)
+	if !ok || len(assignment.Lhs) != 1 || !isName(assignment.Lhs[0], "err") || len(assignment.Rhs) != 1 {
+		return false
+	}
+	call, ok := assignment.Rhs[0].(*ast.CallExpr)
+	if !ok || len(call.Args) != 0 {
+		return false
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || !isName(selector.X, "ctx") || selector.Sel.Name != "Err" {
+		return false
+	}
+	condition, ok := guard.Cond.(*ast.BinaryExpr)
+	if !ok || condition.Op != token.NEQ || !isName(condition.X, "err") || !isName(condition.Y, "nil") {
+		return false
+	}
+	return len(guard.Body.List) == 1 && materialFailureReturn(guard.Body.List[0])
+}
+
+func materialIdentityGate(statement ast.Stmt) bool {
+	gate, ok := statement.(*ast.IfStmt)
+	if !ok || len(gate.Body.List) != 1 {
+		return false
+	}
+	not, ok := gate.Cond.(*ast.UnaryExpr)
+	return ok && not.Op == token.NOT && isName(not.X, "identityOK") && materialFailureReturn(gate.Body.List[0])
+}
+
+func materialSuccessClose(statement ast.Stmt) (string, bool) {
+	gate, ok := statement.(*ast.IfStmt)
+	if !ok || len(gate.Body.List) != 1 || !materialFailureReturn(gate.Body.List[0]) {
+		return "", false
+	}
+	assignment, ok := gate.Init.(*ast.AssignStmt)
+	if !ok || len(assignment.Lhs) != 1 || !isName(assignment.Lhs[0], "err") || len(assignment.Rhs) != 1 {
+		return "", false
+	}
+	call, ok := assignment.Rhs[0].(*ast.CallExpr)
+	if !ok || !calledExpr(call.Fun, "closeMaterial") || len(call.Args) != 2 || !isName(call.Args[1], "nil") {
+		return "", false
+	}
+	if isName(call.Args[0], "pre") {
+		return "pre", true
+	}
+	if isName(call.Args[0], "post") {
+		return "post", true
+	}
+	return "", false
+}
+
+func materialSuccessReturn(statement ast.Stmt) bool {
+	returnValue, ok := statement.(*ast.ReturnStmt)
+	if !ok || len(returnValue.Results) != 2 {
+		return false
+	}
+	literal, ok := returnValue.Results[0].(*ast.CompositeLit)
+	if !ok || !isName(literal.Type, "CandidateMaterialV1") || !isName(returnValue.Results[1], "nil") || len(literal.Elts) != 2 {
+		return false
+	}
+	fields := map[string]bool{}
+	for _, element := range literal.Elts {
+		keyed, ok := element.(*ast.KeyValueExpr)
+		if !ok {
+			return false
+		}
+		switch {
+		case isName(keyed.Key, "Current") && isName(keyed.Value, "current"):
+			fields["Current"] = true
+		case isName(keyed.Key, "CandidatePath") && isName(keyed.Value, "verified"):
+			fields["CandidatePath"] = true
+		default:
+			return false
+		}
+	}
+	return fields["Current"] && fields["CandidatePath"]
+}
+
+func materialFailureReturn(statement ast.Stmt) bool {
+	returnValue, ok := statement.(*ast.ReturnStmt)
+	if !ok || len(returnValue.Results) != 1 {
+		return false
+	}
+	returnValueCall, ok := returnValue.Results[0].(*ast.CallExpr)
+	return ok && calledExpr(returnValueCall.Fun, "materialFailure") && len(returnValueCall.Args) == 1
+}
+
+func materialFailureShape(function *ast.FuncDecl) bool {
+	if function == nil || function.Body == nil || len(function.Body.List) != 2 {
+		return false
+	}
+	guard, ok := function.Body.List[0].(*ast.IfStmt)
+	if !ok || guard.Init != nil || len(guard.Body.List) != 1 {
+		return false
+	}
+	condition, ok := guard.Cond.(*ast.BinaryExpr)
+	if !ok || condition.Op != token.EQL || !isName(condition.X, "cause") || !isName(condition.Y, "nil") {
+		return false
+	}
+	ifStatement, ok := guard.Body.List[0].(*ast.AssignStmt)
+	if !ok || len(ifStatement.Lhs) != 1 || !isName(ifStatement.Lhs[0], "cause") || len(ifStatement.Rhs) != 1 {
+		return false
+	}
+	returnValue, ok := function.Body.List[1].(*ast.ReturnStmt)
+	if !ok || len(returnValue.Results) != 2 || !isName(returnValue.Results[1], "cause") {
+		return false
+	}
+	literal, ok := returnValue.Results[0].(*ast.CompositeLit)
+	return ok && isName(literal.Type, "CandidateMaterialV1") && len(literal.Elts) == 0
+}
+
+func calledExpr(expression ast.Expr, name string) bool {
+	switch function := expression.(type) {
+	case *ast.Ident:
+		return function.Name == name
+	case *ast.SelectorExpr:
+		return function.Sel.Name == name
+	default:
+		return false
+	}
+}
+
+func flagTree(expression ast.Expr, object string) (map[string]int, bool) {
+	counts := make(map[string]int)
+	var visit func(ast.Expr) bool
+	visit = func(expression ast.Expr) bool {
+		switch expression := expression.(type) {
+		case *ast.BinaryExpr:
+			if expression.Op != token.OR {
+				return false
+			}
+			return visit(expression.X) && visit(expression.Y)
+		case *ast.SelectorExpr:
+			if !isName(expression.X, object) || expression.Sel.Name == "" {
+				return false
+			}
+			counts[expression.Sel.Name]++
+			return true
+		default:
+			return false
+		}
+	}
+	return counts, visit(expression)
+}
+
+func isName(expression ast.Expr, name string) bool {
+	identifier, ok := expression.(*ast.Ident)
+	return ok && identifier.Name == name
+}
+
+func isLiteral(expression ast.Expr, value string) bool {
+	literal, ok := expression.(*ast.BasicLit)
+	return ok && literal.Value == value
+}
