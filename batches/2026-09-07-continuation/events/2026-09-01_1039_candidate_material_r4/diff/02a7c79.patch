+func TestCandidateUnixOpen(t *testing.T) {
+	root := t.TempDir()
+	regular := filepath.Join(root, "regular")
+	if err := os.WriteFile(regular, []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(root, "link")
+	if err := os.Symlink(regular, link); err != nil {
+		t.Fatal(err)
+	}
+	fifo := filepath.Join(root, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name string
+		path string
+		kind string
+	}{
+		{name: "symlink", path: link, kind: "source_authority_corrupt"},
+		{name: "regular", path: regular, kind: "source_authority_corrupt"},
+		{name: "missing", path: filepath.Join(root, "missing"), kind: "source_authority_unavailable"},
+		{name: "fifo", path: fifo, kind: "source_authority_corrupt"},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			type outcome struct {
+				file *os.File
+				err  error
+			}
+			channel := make(chan outcome, 1)
+			go func() {
+				file, err := openMaterialDir(item.path)
+				channel <- outcome{file: file, err: err}
+			}()
+			select {
+			case got := <-channel:
+				if got.file != nil {
+					_ = got.file.Close()
+					t.Fatal("special path opened")
+				}
+				assertMaterialError(t, materialOpenError(got.err), item.kind)
+			case <-time.After(time.Second):
+				t.Fatal("special path admission blocked")
+			}
+		})
+	}
+}
