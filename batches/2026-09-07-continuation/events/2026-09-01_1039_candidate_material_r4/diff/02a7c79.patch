+package source
+
+import (
+	"context"
+	"errors"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	storeiface "polaris/internal/store"
+)
+
+func TestCandidateMaterial(t *testing.T) {
+	owner, current, path, _ := materialFixture(t)
+	valid := storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchRestartDurableV1, Current: current}
+	got, err := owner.InspectCandidateMaterial(context.Background(), valid)
+	if err != nil || got.Current != current || got.CandidatePath != path {
+		t.Fatalf("material=%+v err=%v", got, err)
+	}
+
+	cases := []struct {
+		name   string
+		ctx    context.Context
+		owner  *Owner
+		branch storeiface.InitialSourceBranchResultV1
+		kind   string
+	}{
+		{name: "nil context", owner: owner, branch: valid, kind: "source_input_invalid"},
+		{name: "canceled", ctx: canceledContext(), owner: owner, branch: valid, kind: "source_authority_unavailable"},
+		{name: "nil owner", ctx: context.Background(), branch: valid, kind: "source_authority_unavailable"},
+		{name: "first boot", ctx: context.Background(), owner: owner, branch: storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchFirstBootV1}, kind: "source_input_invalid"},
+		{name: "corrupt branch", ctx: context.Background(), owner: owner, branch: storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchCorruptV1, Current: current}, kind: "source_input_invalid"},
+		{name: "malformed digest", ctx: context.Background(), owner: owner, branch: storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchRestartDurableV1, Current: storeiface.SourceAuthorityCurrentV1{CandidateRef: "bad", RootDigest: "bad"}}, kind: "source_input_invalid"},
+		{name: "zero current", ctx: context.Background(), owner: owner, branch: storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchRestartDurableV1}, kind: "source_input_invalid"},
+		{name: "mismatched refs", ctx: context.Background(), owner: owner, branch: storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchRestartDurableV1, Current: storeiface.SourceAuthorityCurrentV1{CandidateRef: current.CandidateRef, RootDigest: digestText("other")}}, kind: "source_input_invalid"},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			ctx := item.ctx
+			if ctx == nil && item.name != "nil context" {
+				ctx = context.Background()
+			}
+			got, err := item.owner.InspectCandidateMaterial(ctx, item.branch)
+			if got != (CandidateMaterialV1{}) {
+				t.Fatalf("failure result=%+v", got)
+			}
+			assertMaterialError(t, err, item.kind)
+		})
+	}
+}
+
+func TestCandidateMaterialFailures(t *testing.T) {
+	t.Run("missing", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		if err := os.Chmod(path, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.RemoveAll(path); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = unlockTree(root) })
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_unavailable")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+	})
+	t.Run("writable file", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		file := filepath.Join(path, "file")
+		if err := os.Chmod(file, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_corrupt")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+		t.Cleanup(func() { _ = unlockTree(root) })
+	})
+	t.Run("writable root", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		if err := os.Chmod(path, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_corrupt")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+		t.Cleanup(func() { _ = unlockTree(root) })
+	})
+	t.Run("wrong bytes", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		file := filepath.Join(path, "file")
+		if err := os.Chmod(path, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chmod(file, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(file, []byte("different"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chmod(file, 0o444); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chmod(path, 0o555); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_corrupt")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+		t.Cleanup(func() { _ = unlockTree(root) })
+	})
+	t.Run("final symlink", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		outside := filepath.Join(root, "missing-outside")
+		if err := os.Chmod(path, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.RemoveAll(path); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, path); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_corrupt")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+	})
+	t.Run("in root symlink", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		outside := filepath.Join(root, "outside")
+		if err := os.Mkdir(outside, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chmod(path, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.RemoveAll(path); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, path); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		assertMaterialError(t, err, "source_authority_corrupt")
+		if result != (CandidateMaterialV1{}) {
+			t.Fatalf("failure result=%+v", result)
+		}
+	})
+	t.Run("bad sibling ignored", func(t *testing.T) {
+		owner, current, path, root := materialFixture(t)
+		sibling := filepath.Join(filepath.Dir(path), strings.Repeat("b", 64))
+		outside := filepath.Join(root, "outside")
+		if err := os.Mkdir(outside, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(outside, sibling); err != nil {
+			t.Fatal(err)
+		}
+		result, err := owner.InspectCandidateMaterial(context.Background(), materialBranch(current))
+		if err != nil || result.CandidatePath != path {
+			t.Fatalf("sibling affected valid material=%+v err=%v", result, err)
+		}
+	})
+}
+
+func TestCandidateIdentity(t *testing.T) {
+	_, current, path, _ := materialFixture(t)
+	rootPath := filepath.Dir(filepath.Dir(path))
+	candidateDir := filepath.Dir(path)
+	pre, err := openHandles(rootPath, candidateDir, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	post, err := openHandles(rootPath, candidateDir, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !sameMaterial(pre, post) {
+		t.Fatal("unchanged handle identities differ")
+	}
+	alternates := []struct {
+		name string
+		set  func(*materialSnapshot, os.FileInfo)
+	}{
+		{name: "root", set: func(snapshot *materialSnapshot, info os.FileInfo) { snapshot.rootInfo = info }},
+		{name: "candidates", set: func(snapshot *materialSnapshot, info os.FileInfo) { snapshot.candidateInfo = info }},
+		{name: "candidate", set: func(snapshot *materialSnapshot, info os.FileInfo) { snapshot.materialInfo = info }},
+	}
+	for _, item := range alternates {
+		t.Run(item.name, func(t *testing.T) {
+			alternate := t.TempDir()
+			file, err := os.Open(alternate)
+			if err != nil {
+				t.Fatal(err)
+			}
+			info, err := file.Stat()
+			closeErr := file.Close()
+			if err != nil || closeErr != nil {
+				t.Fatalf("alternate stat=%v close=%v", err, closeErr)
+			}
+			item.set(post, info)
+			if sameMaterial(pre, post) {
+				t.Fatal("replaced handle identity accepted")
+			}
+			post.rootInfo = pre.rootInfo
+			post.candidateInfo = pre.candidateInfo
+			post.materialInfo = pre.materialInfo
+		})
+	}
+	if err := closeMaterial(pre, nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := closeMaterial(post, nil); err != nil {
+		t.Fatal(err)
+	}
+	if current.CandidateRef == "" {
+		t.Fatal("fixture current missing")
+	}
+}
+
+func TestCandidateDTO(t *testing.T) {
+	typ := reflect.TypeOf(CandidateMaterialV1{})
+	wantCurrent := reflect.TypeOf(storeiface.SourceAuthorityCurrentV1{})
+	wantPath := reflect.TypeOf("")
+	if typ.NumField() != 2 || typ.Field(0).Name != "Current" || typ.Field(0).Type != wantCurrent || typ.Field(1).Name != "CandidatePath" || typ.Field(1).Type != wantPath || typ.Field(0).Tag != "" || typ.Field(1).Tag != "" {
+		t.Fatalf("unexpected DTO=%v", typ)
+	}
+}
+
+func TestCandidateFailure(t *testing.T) {
+	cause := errors.New("material cause")
+	result, err := materialFailure(cause)
+	if result != (CandidateMaterialV1{}) || !errors.Is(err, cause) {
+		t.Fatalf("failure result=%+v err=%v", result, err)
+	}
+	result, err = materialFailure(nil)
+	if result != (CandidateMaterialV1{}) {
+		t.Fatalf("nil failure result=%+v", result)
+	}
+	assertMaterialError(t, err, "source_authority_unavailable")
+}
+
+func materialFixture(t *testing.T) (*Owner, storeiface.SourceAuthorityCurrentV1, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	candidates := filepath.Join(root, "candidates")
+	if err := os.Mkdir(candidates, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	staged := filepath.Join(candidates, "staged")
+	if err := os.Mkdir(staged, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(staged, "file"), []byte("candidate"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := chmodTree(staged, true); err != nil {
+		t.Fatal(err)
+	}
+	digest, err := treeDigest(staged, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(candidates, strings.TrimPrefix(digest, "sha256:"))
+	if err := os.Rename(staged, path); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = unlockTree(root) })
+	return &Owner{root: root}, storeiface.SourceAuthorityCurrentV1{CandidateRef: digest, RootDigest: digest}, path, root
+}
+
+func materialBranch(current storeiface.SourceAuthorityCurrentV1) storeiface.InitialSourceBranchResultV1 {
+	return storeiface.InitialSourceBranchResultV1{Kind: storeiface.InitialSourceBranchRestartDurableV1, Current: current}
+}
+
+func canceledContext() context.Context {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	return ctx
+}
+
+func assertMaterialError(t *testing.T, err error, kind string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("expected %s", kind)
+	}
+	var typed *sourceMutationError
+	if !errors.As(err, &typed) || typed.Kind() != kind {
+		t.Fatalf("error=%v kind=%q want=%q", err, typed.Kind(), kind)
+	}
+}
+
+func TestCandidateClose(t *testing.T) {
+	file, err := os.Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle := file
+	if err := closeHandle(&handle); err != nil {
+		t.Fatal(err)
+	}
+	if handle != nil {
+		t.Fatal("closed handle retained")
+	}
+	if err := closeHandle(&handle); err != nil {
+		t.Fatal(err)
+	}
+	closed, err := os.Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := closed.Close(); err != nil {
+		t.Fatal(err)
+	}
+	primary := errors.New("primary material corruption")
