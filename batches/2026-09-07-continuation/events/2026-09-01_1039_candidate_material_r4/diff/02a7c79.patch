+func TestCandidateUnixFlags(t *testing.T) {
+	file, err := parser.ParseFile(token.NewFileSet(), "owner_material_open_unix.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var function *ast.FuncDecl
+	for _, declaration := range file.Decls {
+		candidate, ok := declaration.(*ast.FuncDecl)
+		if ok && candidate.Name.Name == "openMaterialDir" {
+			function = candidate
+		}
+	}
+	if function == nil {
+		t.Fatal("openMaterialDir missing")
+	}
+	flags := map[string]int{}
+	openFound, newFile, closeFound := false, false, false
+	flagsAssignments, newFileAssignments := 0, 0
+	successReturn, rawCloseCalls, rawCloseReturn := 0, 0, 0
+	flagsPos, openPos := token.NoPos, token.NoPos
+	fileIf, closePos, returnClosePos := token.NoPos, token.NoPos, token.NoPos
+	ast.Inspect(function.Body, func(node ast.Node) bool {
+		statement, ok := node.(*ast.AssignStmt)
+		if ok && len(statement.Lhs) == 1 && isName(statement.Lhs[0], "flags") && len(statement.Rhs) == 1 {
+			flagsAssignments++
+			flagsPos = statement.Pos()
+			var valid bool
+			flags, valid = flagTree(statement.Rhs[0], "unix")
+			if !valid {
+				t.Fatal("flags are not a pure Unix OR tree")
+			}
+		}
+		if ok && len(statement.Lhs) == 1 && isName(statement.Lhs[0], "file") && len(statement.Rhs) == 1 {
+			newFileAssignments++
+		}
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if ok && isName(selector.X, "unix") && selector.Sel.Name == "Open" && len(call.Args) == 3 && isName(call.Args[0], "path") && isName(call.Args[1], "flags") && isLiteral(call.Args[2], "0") {
+			openFound = true
+			openPos = call.Pos()
+		}
+		if ok && isName(selector.X, "os") && selector.Sel.Name == "NewFile" && len(call.Args) == 2 {
+			if callArg, ok := call.Args[0].(*ast.CallExpr); ok {
+				if fn, ok := callArg.Fun.(*ast.Ident); ok && fn.Name == "uintptr" && len(callArg.Args) == 1 && isName(callArg.Args[0], "fd") && isName(call.Args[1], "path") {
+					newFile = true
+				}
+			}
+		}
+		if ok && isName(selector.X, "unix") && selector.Sel.Name == "Close" && len(call.Args) == 1 && isName(call.Args[0], "fd") {
+			closeFound = true
+			rawCloseCalls++
+			closePos = call.Pos()
+		}
+		return true
+	})
+	for _, statement := range function.Body.List {
+		guard, ok := statement.(*ast.IfStmt)
+		if !ok {
+			continue
+		}
+		condition, ok := guard.Cond.(*ast.BinaryExpr)
+		if ok && condition.Op == token.NEQ && isName(condition.X, "file") && isName(condition.Y, "nil") {
+			fileIf = guard.Pos()
+			if len(guard.Body.List) == 1 {
+				if result, ok := guard.Body.List[0].(*ast.ReturnStmt); ok && len(result.Results) == 2 && isName(result.Results[0], "file") && isName(result.Results[1], "nil") {
+					successReturn++
+				}
+			}
+		}
+	}
+	for _, statement := range function.Body.List {
+		result, ok := statement.(*ast.ReturnStmt)
+		if !ok {
+			continue
+		}
+		ast.Inspect(result, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, selectorOK := call.Fun.(*ast.SelectorExpr)
+			if ok && selectorOK && isName(selector.X, "unix") && selector.Sel.Name == "Close" {
+				rawCloseReturn++
+				returnClosePos = call.Pos()
+			}
+			return true
+		})
+	}
+	want := map[string]bool{"O_RDONLY": true, "O_CLOEXEC": true, "O_DIRECTORY": true, "O_NOFOLLOW": true, "O_NONBLOCK": true}
+	if len(flags) != len(want) || !openFound || !newFile || !closeFound || flagsAssignments != 1 || newFileAssignments != 1 || successReturn != 1 || rawCloseCalls != 1 || rawCloseReturn != 1 || fileIf == token.NoPos {
+		t.Fatalf("flags=%v open=%v newFile=%v close=%v flagAssignments=%d fileAssignments=%d success=%d rawClose=%d/%d", flags, openFound, newFile, closeFound, flagsAssignments, newFileAssignments, successReturn, rawCloseCalls, rawCloseReturn)
+	}
+	for name := range want {
+		if flags[name] != 1 {
+			t.Fatalf("missing Unix flag %s", name)
+		}
+	}
+	if flagsPos == token.NoPos || openPos == token.NoPos || flagsPos >= openPos || closePos <= fileIf || returnClosePos != closePos {
+		t.Fatalf("raw open/close control-flow flags=%v open=%v fileIf=%v close=%v returnClose=%v", flagsPos, openPos, fileIf, closePos, returnClosePos)
+	}
+}
