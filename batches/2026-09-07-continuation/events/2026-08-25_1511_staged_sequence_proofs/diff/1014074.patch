+func TestSequenceStageBranches(t *testing.T) {
+	binding := types.NewVar(token.NoPos, nil, "clauses", types.NewSlice(types.Typ[types.String]))
+	selected := newEnv()
+	selected.sequences["stage"] = sequenceState{id: "stage", version: 1, binding: binding}
+	selected.branchGuards["stage"] = branchState{id: "parent", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchThen}
+	parents := snapshotIfBranches(selected)
+	original := selected.branchGuards["stage"]
+	selected.branchGuards["stage"] = branchState{id: "mutated", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchElse}
+	if parents["stage"].id != "parent" || parents["stage"].path != branchThen {
+		t.Fatal("parent branch snapshot shared the selected map")
+	}
+	selected.branchGuards["stage"] = original
+	child := selected.clone()
+	child.branchGuards["stage"] = branchState{id: "inner", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchUnknown}
+	exits := restoreIfBranches([]typedExit{normalExit(child)}, parents)
+	if exits[0].env.branchGuards["stage"].id != "parent" || exits[0].env.branchGuards["stage"].path != branchThen {
+		t.Fatalf("parent branch was not restored: %+v", exits[0].env.branchGuards)
+	}
+	if child.branchGuards["stage"].id != "inner" {
+		t.Fatal("branch restore wrote through child env")
+	}
+	missing := selected.clone()
+	delete(missing.branchGuards, "stage")
+	missingExit := restoreIfBranches([]typedExit{normalExit(missing)}, parents)
+	if _, ok := missingExit[0].env.branchGuards["stage"]; ok {
+		t.Fatal("missing current branch was revived")
+	}
+	active := selected.clone()
+	active.branchGuards["stage"] = branchState{id: "inner", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchElse}
+	activeExit := restoreIfBranches([]typedExit{normalExit(active)}, parents)
+	if activeExit[0].env.branchGuards["stage"].id != "inner" || activeExit[0].env.branchGuards["stage"].path != branchElse {
+		t.Fatal("active child branch was overwritten")
+	}
+	invalid := selected.clone()
+	invalid.branchGuards["stage"] = branchState{id: "parent", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchUnknown}
+	invalidParents := snapshotIfBranches(invalid)
+	invalidExit := restoreIfBranches([]typedExit{normalExit(invalid)}, invalidParents)
+	if invalidExit[0].env.branchGuards["stage"].path != branchUnknown {
+		t.Fatal("invalid parent branch was restored")
+	}
+	same := selected.clone()
+	sameExit := restoreIfBranches([]typedExit{normalExit(same)}, parents)
+	if sameExit[0].env.branchGuards["stage"].id != "parent" || sameExit[0].env.branchGuards["stage"].path != branchThen {
+		t.Fatal("same parent branch was rewritten")
+	}
+	abrupt := child.clone()
+	abruptExit := restoreIfBranches([]typedExit{{kind: exitReturn, env: abrupt}}, parents)
+	if abruptExit[0].env.branchGuards["stage"].id != "inner" || abruptExit[0].env.branchGuards["stage"].path != branchUnknown {
+		t.Fatal("abrupt branch was restored")
+	}
+}
