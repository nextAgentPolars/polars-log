+package sqliteinventory
+
+import (
+	"go/token"
+	"go/types"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func TestSequenceStageProduction(t *testing.T) {
+	repo := filepath.Clean(filepath.Join(packageDir(t), "..", "..", ".."))
+	report, err := Analyze(repo, Options{Roots: []string{"internal/store/sqlite"}, SQLRoots: []string{"internal/store/sqlite"}})
+	if err == nil || len(report.Diagnostics) != 1 || countDiagnostics(report.Diagnostics, "unknown_sql") != 1 {
+		t.Fatalf("input ledger did not leave only known diagnostic: err=%v diagnostics=%+v", err, report.Diagnostics)
+	}
+	execution := executionForFunction(report.Executions, "ListInputLedgerEvents")
+	if execution == nil {
+		t.Fatalf("missing input ledger execution: %+v", report.Executions)
+	}
+	if !execution.Complete || execution.Value.Kind != Template || !execution.Value.SequenceGuard.AllowsEmpty || execution.Fact.Target != "input_ledger_events" {
+		t.Fatalf("input ledger receipt incomplete: %+v", *execution)
+	}
+	texts, ok := corpusWitnesses(execution.Value)
+	if !ok || !variantsContain(texts, " ORDER BY created_at ASC, input_id ASC") || execution.Value.NumericTail == nil || !execution.Value.NumericTail.Optional {
+		t.Fatalf("input ledger witnesses incomplete: ok=%t texts=%+v value=%+v", ok, texts, execution.Value)
+	}
+	for _, fragment := range []string{"input_id = ?", "source_kind = ?", "source_ref = ?", "root_ref = ?", "task_id = ?", "input_type = ?", "event_kind = ?", "classification = ?", "promotion_state = ?"} {
+		if !variantsContain(texts, fragment) {
+			t.Fatalf("input ledger witness missed %q: %+v", fragment, texts)
+		}
+	}
+	active := "superseded_by_input_id = '' AND promotion_state <> ? AND (expires_at = '' OR expires_at > ?)"
+	if !variantsContain(texts, active) {
+		t.Fatalf("input ledger witness missed active-only predicate %q: %+v", active, texts)
+	}
+}
+
+func TestSequenceStageFixture(t *testing.T) {
+	cases := []struct {
+		name string
+		body string
+		want bool
+	}{
+		{name: "positive", body: `if len(clauses) > 0 {
+    query += " WHERE " + strings.Join(clauses, " AND ")
+}
+if active {
+    if len(clauses) == 0 { query += " WHERE " } else { query += " AND " }
+    query += "active = ?"
+}
+`, want: true},
+		{name: "pending", body: `if flag {
+    query += " WHERE " + strings.Join(clauses, " AND ")
+}
+`, want: false},
+		{name: "dynamic", body: `if len(clauses) > 0 && flag {
+    query += " WHERE " + strings.Join(clauses, " AND ")
+}
+query += input
+`, want: false},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			report, err := Analyze(writeFixture(t, stageSource(test.body)), Options{})
+			if countDiagnostics(report.Diagnostics, "typecheck_error") != 0 {
+				t.Fatalf("typecheck diagnostics=%+v", report.Diagnostics)
+			}
+			if len(report.Executions) != 1 {
+				t.Fatalf("executions=%+v diagnostics=%+v", report.Executions, report.Diagnostics)
+			}
+			execution := report.Executions[0]
+			if test.want && (err != nil || !execution.Complete || execution.Value.Kind != Template || execution.Value.SequenceGuard == nil || !execution.Value.SequenceGuard.AllowsEmpty) {
+				t.Fatalf("stage receipt missing: err=%v execution=%+v diagnostics=%+v", err, execution, report.Diagnostics)
+			}
+			if test.want {
+				return
+			}
+			if err == nil || execution.Complete || len(report.Diagnostics) != 1 || countDiagnostics(report.Diagnostics, "unknown_sql") != 1 {
+				t.Fatalf("stage rejection missing: err=%v execution=%+v diagnostics=%+v", err, execution, report.Diagnostics)
+			}
+		})
+	}
+}
+
+func stagePaths(count int) (SQLValue, SQLValue, valueEnv, valueEnv) {
+	binding := types.NewVar(token.NoPos, nil, "clauses", types.NewSlice(types.Typ[types.String]))
+	atoms := make([]sequenceAtom, count)
+	values := make([]SequenceAtom, count)
+	for index := range atoms {
+		atoms[index] = sequenceAtom{value: exactValue("status = ?"), presence: SequenceRequired, minCount: 1, maxCount: 1}
+		values[index] = SequenceAtom{Value: exactValue("status = ?"), Presence: SequenceRequired, Proof: FragmentProof{Role: "predicate", Separator: " AND "}, MinCount: 1, MaxCount: 1}
+	}
+	leftEnv := newEnv()
+	rightEnv := newEnv()
+	leftEnv.sequences["stage"] = sequenceState{id: "stage", version: 1, binding: binding, atoms: atoms}
+	rightEnv.sequences["stage"] = sequenceState{id: "stage", version: 1, binding: binding, atoms: append([]sequenceAtom(nil), atoms...)}
+	leftEnv.guards["stage"] = guardState{id: "guard", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: guardPathNonEmpty, minCount: 1, maxCount: -1}
+	rightEnv.guards["stage"] = leftEnv.guards["stage"]
+	leftEnv.branchGuards["stage"] = branchState{id: "branch", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchThen}
+	rightEnv.branchGuards["stage"] = branchState{id: "branch", sequenceID: "stage", sequenceVersion: 1, binding: binding, path: branchElse}
+	boundary := func(prefix, suffix, nonemptyPrefix, nonemptySuffix string) *SequenceBoundary {
+		return &SequenceBoundary{GuardID: "guard", GuardKind: "length", SourceSequenceID: "stage", SourceSequenceVersion: 1, CommonPrefix: prefix, CommonSuffix: suffix, AllowsEmpty: true, NonEmptyPrefix: nonemptyPrefix, NonEmptySuffix: nonemptySuffix}
+	}
+	left := SQLValue{Kind: Template, Sequence: append([]SequenceAtom(nil), values...), SequenceID: "stage", SequenceVersion: 1, SequenceSep: " AND ", SequencePre: "SELECT id FROM tasks WHERE ", SequencePost: "active = ?", SequenceGuard: boundary("SELECT id FROM tasks WHERE ", "active = ?", "", " AND ")}
+	rightValues := append([]SequenceAtom(nil), values...)
+	right := SQLValue{Kind: Template, Sequence: rightValues, SequenceID: "stage", SequenceVersion: 1, SequenceSep: " AND ", SequencePre: "SELECT id FROM tasks", SequenceGuard: boundary("SELECT id FROM tasks", "", " WHERE ", "")}
+	return left, right, leftEnv, rightEnv
+}
+
+func TestSequenceStageAtom(t *testing.T) {
+	for _, count := range []int{1, 31, 32} {
+		t.Run("peers-"+strconv.Itoa(count), func(t *testing.T) {
+			left, right, leftEnv, rightEnv := stagePaths(count)
+			beforeLeft, beforeRight := leftEnv.clone(), rightEnv.clone()
+			got, ok := joinStageAtom(left, right, leftEnv, rightEnv)
+			fact, parsed := parseSQLSequence(got)
+			if count == 32 && ok {
+				t.Fatalf("cap overflow accepted: %+v", got)
+			}
+			if count == 32 {
+				return
+			}
+			if !ok || got.SequenceGuard == nil || len(got.Sequence) != count+1 || got.Sequence[count].Presence != SequenceOptional || got.Sequence[count].Proof.ControlKind != "branch" || got.Sequence[count].Value.Text != "active = ?" || !sequenceShapeSafe(got) || !parsed || fact.Target != "tasks" {
+				t.Fatalf("stage atom count=%d: %+v", count, got)
+			}
+			if reflect.DeepEqual(leftEnv, beforeLeft) == false || reflect.DeepEqual(rightEnv, beforeRight) == false {
+				t.Fatal("stage atom mutated input environment")
+			}
+			got.SequenceGuard.CommonPrefix = "mutated"
+			if left.SequenceGuard.CommonPrefix == "mutated" || right.SequenceGuard.CommonPrefix == "mutated" {
+				t.Fatal("stage atom wrote through input boundary")
+			}
+		})
+	}
+}
+
+func TestSequenceStageRejects(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*SQLValue, *SQLValue, *valueEnv, *valueEnv)
+	}{
+		{name: "atom", mutate: func(left, right *SQLValue, _ *valueEnv, _ *valueEnv) {
+			right.Sequence[0].Value = exactValue("other = ?")
+		}},
+		{name: "separator", mutate: func(left, right *SQLValue, _ *valueEnv, _ *valueEnv) {
+			right.SequenceSep = ", "
+		}},
+		{name: "source-version", mutate: func(left, right *SQLValue, _ *valueEnv, _ *valueEnv) {
+			left.SequenceGuard.SourceSequenceVersion = 2
+		}},
+		{name: "target-version", mutate: func(left, right *SQLValue, leftEnv, _ *valueEnv) {
+			sequence := leftEnv.sequences["stage"]
+			sequence.version = 2
+			leftEnv.sequences["stage"] = sequence
+		}},
+		{name: "stale-equal", mutate: func(left, right *SQLValue, leftEnv, _ *valueEnv) {
+			sequence := leftEnv.sequences["stage"]
+			sequence.version = 2
+			leftEnv.sequences["stage"] = sequence
+			*right = *left
+		}},
+		{name: "target-binding", mutate: func(left, right *SQLValue, _ *valueEnv, rightEnv *valueEnv) {
+			sequence := rightEnv.sequences["stage"]
+			sequence.binding = types.NewVar(token.NoPos, nil, "other", types.NewSlice(types.Typ[types.String]))
+			rightEnv.sequences["stage"] = sequence
+		}},
+		{name: "boundary-guard", mutate: func(left, right *SQLValue, _ *valueEnv, _ *valueEnv) {
+			right.SequenceGuard.GuardID = "other"
+		}},
+		{name: "guard-cardinality", mutate: func(left, right *SQLValue, leftEnv, _ *valueEnv) {
+			guard := leftEnv.guards["stage"]
+			guard.maxCount = 1
+			leftEnv.guards["stage"] = guard
+		}},
+		{name: "branch", mutate: func(left, right *SQLValue, _ *valueEnv, rightEnv *valueEnv) {
+			branch := rightEnv.branchGuards["stage"]
+			branch.path = branchThen
+			rightEnv.branchGuards["stage"] = branch
+		}},
+		{name: "danger", mutate: func(left, right *SQLValue, _ *valueEnv, _ *valueEnv) {
+			left.SequencePost = " AND x = 'unsafe; DROP'"
+			left.SequenceGuard.CommonSuffix = left.SequencePost
+		}},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			left, right, leftEnv, rightEnv := stagePaths(1)
+			test.mutate(&left, &right, &leftEnv, &rightEnv)
+			_, ok := joinStageAtom(left, right, leftEnv, rightEnv)
+			if ok {
+				t.Fatal("unsafe stage atom accepted")
+			}
+			joined := joinValueAtPaths(left, right, leftEnv, rightEnv, 64)
+			if joined.Kind != Unknown {
+				t.Fatalf("unsafe stage join escaped fail-closed: %+v", joined)
+			}
+		})
+	}
+}
