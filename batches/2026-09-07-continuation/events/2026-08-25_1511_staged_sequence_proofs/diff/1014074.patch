+func connectorPaths() (SQLValue, SQLValue, valueEnv, valueEnv) {
+	left, right, leftEnv, rightEnv := stagePaths(1)
+	leftGuard := leftEnv.guards["stage"]
+	leftGuard.path = guardPathNonEmpty
+	leftGuard.minCount, leftGuard.maxCount = 1, -1
+	leftEnv.guards["stage"] = leftGuard
+	rightGuard := rightEnv.guards["stage"]
+	rightGuard.path = guardPathEmpty
+	rightGuard.minCount, rightGuard.maxCount = 0, 0
+	rightEnv.guards["stage"] = rightGuard
+	common := "SELECT id FROM tasks"
+	left.SequencePre = common
+	left.SequencePost = " AND "
+	left.SequenceGuard = &SequenceBoundary{GuardID: "length", GuardKind: "length", SourceSequenceID: "stage", SourceSequenceVersion: 1, CommonPrefix: common, CommonSuffix: " AND ", AllowsEmpty: true, NonEmptyPrefix: " WHERE "}
+	right.SequencePre = common
+	right.SequencePost = " WHERE "
+	right.SequenceGuard = &SequenceBoundary{GuardID: "length", GuardKind: "length", SourceSequenceID: "stage", SourceSequenceVersion: 1, CommonPrefix: common, CommonSuffix: " WHERE ", AllowsEmpty: true, NonEmptyPrefix: " WHERE "}
+	return left, right, leftEnv, rightEnv
+}
