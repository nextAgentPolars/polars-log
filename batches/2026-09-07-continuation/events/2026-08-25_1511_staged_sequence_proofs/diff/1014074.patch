+
+func snapshotIfBranches(selected valueEnv) map[string]branchState {
+	parents := make(map[string]branchState)
+	for id := range selected.branchGuards {
+		sequence, ok := sequenceByID(selected, id)
+		if !ok {
+			continue
+		}
+		branch := branchFor(selected, "", sequence)
+		if branch.id == "" {
+			continue
+		}
+		if branch.path != branchThen && branch.path != branchElse {
+			continue
+		}
+		parents[id] = branch
+	}
+	return parents
+}
+
+func restoreIfBranches(exits []typedExit, parents map[string]branchState) []typedExit {
+	for index := range exits {
+		if exits[index].kind != exitNormal {
+			continue
+		}
+		cloned := false
+		for id, parent := range parents {
+			sequence, ok := sequenceByID(exits[index].env, id)
+			if !ok || sequence.unknown || sequence.version != parent.sequenceVersion || !sameBinding(sequence.binding, parent.binding) {
+				continue
+			}
+			current := branchFor(exits[index].env, "", sequence)
+			if current.id == "" || current.id == parent.id || current.path != branchUnknown {
+				continue
+			}
+			if !cloned {
+				exits[index].env = exits[index].env.clone()
+				cloned = true
+			}
+			exits[index].env.branchGuards[id] = parent
+		}
+	}
+	return exits
+}
