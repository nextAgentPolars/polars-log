+				t.Fatalf("typecheck diagnostics=%+v", report.Diagnostics)
+			}
+			if err == nil || len(report.Executions) != 1 || report.Executions[0].Complete || len(report.Diagnostics) != 1 || countDiagnostics(report.Diagnostics, "unknown_sql") != 1 {
+				t.Fatalf("dangerous atom accepted: err=%v execution=%+v diagnostics=%+v", err, report.Executions, report.Diagnostics)
+			}
+		})
