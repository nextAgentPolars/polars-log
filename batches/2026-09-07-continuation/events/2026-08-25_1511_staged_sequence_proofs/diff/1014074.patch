+func TestSequenceStageConnector(t *testing.T) {
+	left, right, leftEnv, rightEnv := connectorPaths()
+	leftBefore, rightBefore := left, right
+	got, ok := joinStageConnector(left, right, leftEnv, rightEnv)
+	if !ok || got.Kind != Template || got.SequencePre != "SELECT id FROM tasks WHERE " || got.SequencePost != "" || got.SequenceGuard == nil || got.SequenceGuard.GuardID != "guard" {
+		t.Fatalf("connector was not normalized: ok=%t value=%+v", ok, got)
+	}
+	if _, accepted := parseSQLSequence(got); accepted {
+		t.Fatal("pending connector was parsed without outer atom")
+	}
+	if !reflect.DeepEqual(left, leftBefore) || !reflect.DeepEqual(right, rightBefore) {
+		t.Fatal("connector wrote through input values")
+	}
+	reverse, reverseOK := joinStageConnector(right, left, rightEnv, leftEnv)
+	if !reverseOK || !reflect.DeepEqual(got, reverse) {
+		t.Fatalf("connector symmetry failed: forward=%+v reverse=%+v", got, reverse)
+	}
+	wrongEmpty := right
+	wrongEmpty.SequenceGuard = cloneSequenceBoundary(right.SequenceGuard)
+	wrongEmpty.SequencePost = " OR "
+	wrongEmpty.SequenceGuard.CommonSuffix = wrongEmpty.SequencePost
+	if _, accepted := joinStageConnector(left, wrongEmpty, leftEnv, rightEnv); accepted {
+		t.Fatal("wrong empty connector was accepted")
+	}
+	wrongNonempty := left
+	wrongNonempty.SequenceGuard = cloneSequenceBoundary(left.SequenceGuard)
+	wrongNonempty.SequencePost = " OR "
+	wrongNonempty.SequenceGuard.CommonSuffix = wrongNonempty.SequencePost
+	if _, accepted := joinStageConnector(wrongNonempty, right, leftEnv, rightEnv); accepted {
+		t.Fatal("wrong connector was accepted")
+	}
+	nonComplementary := rightEnv.clone()
+	guard := nonComplementary.guards["stage"]
+	guard.path = guardPathNonEmpty
+	guard.minCount, guard.maxCount = 1, -1
+	nonComplementary.guards["stage"] = guard
+	if _, accepted := joinStageConnector(left, right, leftEnv, nonComplementary); accepted {
+		t.Fatal("same-cardinality connector was accepted")
+	}
+	joined := joinValueAtPaths(left, right, leftEnv, nonComplementary, 64)
+	if joined.Kind != Unknown {
+		t.Fatalf("same-cardinality connector escaped fail-closed: %+v", joined)
+	}
+}
