+func TestSequenceStageCarry(t *testing.T) {
+	left, right, leftEnv, rightEnv := stagePaths(1)
+	left = right
+	got := joinValueAtPaths(left, right, leftEnv, rightEnv, 64)
+	if !equalValue(got, left) {
+		t.Fatalf("valid existing receipt was not carried: got=%+v want=%+v", got, left)
+	}
+	nonComplementary := rightEnv.clone()
+	branch := nonComplementary.branchGuards["stage"]
+	branch.path = branchThen
+	nonComplementary.branchGuards["stage"] = branch
+	got = joinValueAtPaths(left, right, leftEnv, nonComplementary, 64)
+	if !equalValue(got, left) {
+		t.Fatalf("valid equal receipt was rejected: got=%+v want=%+v", got, left)
+	}
+
+	connectorLeft, connectorRight, connectorLeftEnv, connectorRightEnv := connectorPaths()
+	pending, ok := joinStageConnector(connectorLeft, connectorRight, connectorLeftEnv, connectorRightEnv)
+	if !ok {
+		t.Fatal("failed to build pending connector")
+	}
+	joined := joinValueAtPaths(pending, pending, connectorLeftEnv, connectorRightEnv, 64)
+	if joined.Kind != Unknown {
+		t.Fatalf("pending equal connector was carried: %+v", joined)
+	}
+}
