+func stageSource(body string) string {
+	return `package main
+import ("database/sql"; "strings")
+var _ = strings.TrimSpace
+var external string
+func run(db *sql.DB, input string, flag, active bool) {
+    query := "SELECT id FROM tasks"
+    clauses := make([]string, 0)
+    if flag { clauses = append(clauses, "status = ?") }
+` + body + `    db.Query(query)
+}
+func main() { db, _ := sql.Open("", ""); run(db, external, false, false) }
+`
+}
