@@ -1,5 +1,10 @@
 package sqliteinventory
 
+import (
+	"reflect"
+	"strings"
+)
+
 // sequenceJoinProof is built only from the two environments being joined.
 // A string prefix is not evidence: both paths must carry the same typed source
 // sequence, version, and complementary source-position length guard.
@@ -140,5 +145,230 @@ func joinValueAtPaths(left, right SQLValue, leftEnv, rightEnv valueEnv, limit in
 		}
 		return unknownValue("exact path is not the proven empty sequence witness")
 	}
-	return joinValue(left, right, limit)
+	if left.Kind != Template || right.Kind != Template {
+		return joinValue(left, right, limit)
+	}
+	if !stageCandidate(left, right) {
+		return joinValue(left, right, limit)
+	}
+	if !sameStageSource(left, right, leftEnv, rightEnv) {
+		return unknownValue("staged sequence proof is stale")
+	}
+	equal := equalSequenceTemplate(left, right)
+	if equal && !stageCarry(left, right, leftEnv, rightEnv) {
+		return unknownValue("staged sequence receipt is stale")
+	}
+	if equal {
+		return left
+	}
+	if value, ok := joinStageConnector(left, right, leftEnv, rightEnv); ok {
+		return value
+	}
+	if value, ok := joinStageAtom(left, right, leftEnv, rightEnv); ok {
+		return value
+	}
+	return unknownValue("staged sequence alternatives lack complementary proof")
+}
+
+func stageCandidate(left, right SQLValue) bool {
+	leftBound := left.SequenceGuard
+	rightBound := right.SequenceGuard
+	if left.SequenceID == "" || left.SequenceID != right.SequenceID || left.SequenceVersion != right.SequenceVersion || left.SequenceSep == "" || left.SequenceSep != right.SequenceSep {
+		return false
+	}
+	if leftBound == nil || rightBound == nil || leftBound.GuardKind != "length" || rightBound.GuardKind != "length" || !leftBound.AllowsEmpty || !rightBound.AllowsEmpty {
+		return false
+	}
+	return leftBound.SourceSequenceID != "" && leftBound.SourceSequenceID == rightBound.SourceSequenceID && leftBound.SourceSequenceVersion == rightBound.SourceSequenceVersion
+}
+
+func sameStageSource(left, right SQLValue, leftEnv, rightEnv valueEnv) bool {
+	if left.SequenceID == "" || left.SequenceID != right.SequenceID || left.SequenceVersion != right.SequenceVersion {
+		return false
+	}
+	if left.SequenceSep == "" || left.SequenceSep != right.SequenceSep || !reflect.DeepEqual(left.Sequence, right.Sequence) {
+		return false
+	}
+	leftBound := left.SequenceGuard
+	rightBound := right.SequenceGuard
+	if leftBound == nil || rightBound == nil || !leftBound.AllowsEmpty || !rightBound.AllowsEmpty {
+		return false
+	}
+	if leftBound.GuardKind != "length" || rightBound.GuardKind != "length" || leftBound.SourceSequenceID == "" || leftBound.SourceSequenceID != rightBound.SourceSequenceID || leftBound.SourceSequenceVersion != rightBound.SourceSequenceVersion {
+		return false
+	}
+	leftTarget, leftOK := sequenceByID(leftEnv, left.SequenceID)
+	rightTarget, rightOK := sequenceByID(rightEnv, right.SequenceID)
+	if !leftOK || !rightOK || !stageStateCurrent(leftTarget, left.SequenceID, left.SequenceVersion) || !stageStateCurrent(rightTarget, right.SequenceID, right.SequenceVersion) {
+		return false
+	}
+	if !sameBinding(leftTarget.binding, rightTarget.binding) {
+		return false
+	}
+	leftSource, leftOK := sequenceByID(leftEnv, leftBound.SourceSequenceID)
+	rightSource, rightOK := sequenceByID(rightEnv, rightBound.SourceSequenceID)
+	if !leftOK || !rightOK || !stageStateCurrent(leftSource, leftBound.SourceSequenceID, leftBound.SourceSequenceVersion) || !stageStateCurrent(rightSource, rightBound.SourceSequenceID, rightBound.SourceSequenceVersion) {
+		return false
+	}
+	if !sameBinding(leftSource.binding, rightSource.binding) {
+		return false
+	}
+	if leftTarget.boundarySequenceID != "" && (leftTarget.boundarySequenceID != leftBound.SourceSequenceID || leftTarget.boundarySequenceVersion != leftBound.SourceSequenceVersion) {
+		return false
+	}
+	if rightTarget.boundarySequenceID != "" && (rightTarget.boundarySequenceID != rightBound.SourceSequenceID || rightTarget.boundarySequenceVersion != rightBound.SourceSequenceVersion) {
+		return false
+	}
+	return true
+}
+
+func stageStateCurrent(state sequenceState, id string, version int) bool {
+	return !state.unknown && state.id == id && state.version == version && state.binding != nil
+}
+
+func stageCarry(left, right SQLValue, leftEnv, rightEnv valueEnv) bool {
+	if !sequenceShapeSafe(left) || !sequenceShapeSafe(right) {
+		return false
+	}
+	if !sameStageSource(left, right, leftEnv, rightEnv) {
+		return false
+	}
+	leftSequence, leftOK := sequenceByID(leftEnv, left.SequenceID)
+	rightSequence, rightOK := sequenceByID(rightEnv, right.SequenceID)
+	if !leftOK || !rightOK {
+		return false
+	}
+	if _, leftOK := sequenceBoundaryReceiptFor(leftEnv, left, leftSequence); !leftOK {
+		return false
+	}
+	if _, rightOK := sequenceBoundaryReceiptFor(rightEnv, right, rightSequence); !rightOK {
+		return false
+	}
+	return true
+}
+
+func stageGuard(env valueEnv, value SQLValue) (guardState, bool) {
+	bound := value.SequenceGuard
+	if bound == nil || bound.GuardID == "" || bound.SourceSequenceID == "" {
+		return guardState{}, false
+	}
+	sequence, ok := sequenceByID(env, bound.SourceSequenceID)
+	if !ok || !stageStateCurrent(sequence, bound.SourceSequenceID, bound.SourceSequenceVersion) {
+		return guardState{}, false
+	}
+	guard := guardFor(env, "", sequence)
+	if guard.sequenceID != sequence.id || guard.sequenceVersion != sequence.version || !sameBinding(guard.binding, sequence.binding) {
+		return guardState{}, false
+	}
+	if !guardCardinalityMatches(guard) {
+		return guardState{}, false
+	}
+	return guard, true
+}
+
+func joinStageConnector(left, right SQLValue, leftEnv, rightEnv valueEnv) (SQLValue, bool) {
+	if !sameStageSource(left, right, leftEnv, rightEnv) {
+		return SQLValue{}, false
+	}
+	if left.SequenceGuard.GuardID == "" || left.SequenceGuard.GuardID != right.SequenceGuard.GuardID {
+		return SQLValue{}, false
+	}
+	leftGuard, leftOK := stageGuard(leftEnv, left)
+	rightGuard, rightOK := stageGuard(rightEnv, right)
+	if !leftOK || !rightOK || complementaryGuard(leftGuard, rightGuard) == "" {
+		return SQLValue{}, false
+	}
+	empty, nonempty := left, right
+	if leftGuard.path == guardPathNonEmpty {
+		empty, nonempty = right, left
+	}
+	emptyBound := empty.SequenceGuard
+	nonemptyBound := nonempty.SequenceGuard
+	if empty.SequencePre != emptyBound.CommonPrefix || empty.SequencePost != emptyBound.CommonSuffix || nonempty.SequencePre != nonemptyBound.CommonPrefix || nonempty.SequencePost != nonemptyBound.CommonSuffix {
+		return SQLValue{}, false
+	}
+	if emptyBound.NonEmptyPrefix != nonemptyBound.NonEmptyPrefix || emptyBound.NonEmptySuffix != nonemptyBound.NonEmptySuffix {
+		return SQLValue{}, false
+	}
+	emptyText := empty.SequencePre + empty.SequencePost
+	nonemptyPre := nonempty.SequencePre + nonemptyBound.NonEmptyPrefix
+	if emptyText == "" || emptyText != nonemptyPre {
+		return SQLValue{}, false
+	}
+	if nonemptyBound.NonEmptySuffix+nonempty.SequencePost != nonempty.SequenceSep {
+		return SQLValue{}, false
+	}
+	result := nonempty
+	result.SequencePre = emptyText
+	result.SequencePost = ""
+	bound := *nonemptyBound
+	bound.GuardID = nonemptyGuardID(leftGuard, rightGuard)
+	bound.CommonPrefix = result.SequencePre
+	bound.CommonSuffix = ""
+	bound.NonEmptyPrefix = ""
+	bound.NonEmptySuffix += nonempty.SequencePost
+	result.SequenceGuard = &bound
+	result.Reason = "staged sequence connector"
+	return result, true
+}
+
+func nonemptyGuardID(left, right guardState) string {
+	if left.id == right.id {
+		return left.id
+	}
+	return ""
+}
+
+func joinStageAtom(left, right SQLValue, leftEnv, rightEnv valueEnv) (SQLValue, bool) {
+	if !sameStageSource(left, right, leftEnv, rightEnv) {
+		return SQLValue{}, false
+	}
+	leftSeq, leftOK := sequenceByID(leftEnv, left.SequenceID)
+	rightSeq, rightOK := sequenceByID(rightEnv, right.SequenceID)
+	if !leftOK || !rightOK {
+		return SQLValue{}, false
+	}
+	if _, ok := sequenceBoundaryReceiptFor(leftEnv, left, leftSeq); !ok {
+		return SQLValue{}, false
+	}
+	if _, ok := sequenceBoundaryReceiptFor(rightEnv, right, rightSeq); !ok {
+		return SQLValue{}, false
+	}
+	evidence := complementaryBranch(branchFor(leftEnv, "", leftSeq), branchFor(rightEnv, "", rightSeq))
+	if evidence == "" {
+		return SQLValue{}, false
+	}
+	base, extended := left, right
+	leftBranch := branchFor(leftEnv, "", leftSeq)
+	if leftBranch.path == branchThen {
+		base, extended = right, left
+	}
+	baseBound := base.SequenceGuard
+	extBound := extended.SequenceGuard
+	if base.SequencePre != baseBound.CommonPrefix || base.SequencePost != baseBound.CommonSuffix || extended.SequencePre != extBound.CommonPrefix || extended.SequencePost != extBound.CommonSuffix {
+		return SQLValue{}, false
+	}
+	if baseBound.NonEmptyPrefix == "" || extended.SequencePre != base.SequencePre+baseBound.NonEmptyPrefix {
+		return SQLValue{}, false
+	}
+	if extBound.NonEmptyPrefix != "" || extBound.NonEmptySuffix != baseBound.NonEmptySuffix+base.SequenceSep || !strings.HasSuffix(extended.SequencePost, base.SequencePost) {
+		return SQLValue{}, false
+	}
+	extra := strings.TrimSuffix(extended.SequencePost, base.SequencePost)
+	role := sequenceRole(base.SequenceSep, extra)
+	if extra == "" || role == "" {
+		return SQLValue{}, false
+	}
+	if len(base.Sequence) >= predAltCap {
+		return SQLValue{}, false
+	}
+	result := base
+	result.Sequence = append([]SequenceAtom(nil), base.Sequence...)
+	result.Sequence = append(result.Sequence, SequenceAtom{Value: exactValue(extra), Presence: SequenceOptional, Proof: FragmentProof{Role: role, Separator: base.SequenceSep, GuardID: evidence, ControlKind: "branch"}, MinCount: 0, MaxCount: 1})
+	result.SequenceGuard = cloneSequenceBoundary(baseBound)
+	if !sequenceShapeSafe(result) {
+		return SQLValue{}, false
+	}
+	result.Reason = "staged optional sequence atom"
+	return result, true
 }
