+from __future__ import annotations
+
+import contextlib
+import hashlib
+import io
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import preflight_root
+from preflight_fixture import FakeRunner, Fixture, FixtureTestCase
+
+
+class RootPreflightTests(FixtureTestCase):
+    def test_probe_output_limit_fails_closed(self) -> None:
+        completed = preflight_root._default_command_runner(
+            [sys.executable, "-c", "print('x' * (256 * 1024 + 1))"],
+            self.fixture.root,
+        )
+        self.assertEqual(125, completed.returncode)
+        self.assertEqual("probe output limit", completed.stderr)
+
+    def test_legacy_dirty_development_passes_and_records_status_hash(self) -> None:
+        self.fixture.runner.status = "?? legacy.txt"
+        result = self.fixture.evaluate()
+        self.assertEqual("passed", result["status"])
+        self.assertTrue(result["repo"]["dirty"])
+        self.assertEqual(
+            hashlib.sha256(b"?? legacy.txt").hexdigest(),
+            result["repo"]["status_sha256"],
+        )
+
+    def test_invalid_profile_is_cli_error_64(self) -> None:
+        stderr = io.StringIO()
+        with contextlib.redirect_stderr(stderr):
+            code = preflight_root.main(["--profile", "bogus"])
+        self.assertEqual(64, code)
+        self.assertIn("--profile", stderr.getvalue())
+
+    def test_isolated_cli_imports_do_not_write_bytecode(self) -> None:
+        source_scripts = Path(preflight_root.__file__).resolve().parent
+        with tempfile.TemporaryDirectory() as raw_root:
+            root = Path(raw_root)
+            target_scripts = root / "scripts"
+            target_scripts.mkdir()
+            shutil.copy2(source_scripts / "preflight_root.py", target_scripts / "preflight_root.py")
+            target_package = target_scripts / "root_preflight"
+            target_package.mkdir()
+            for source in (source_scripts / "root_preflight").glob("*.py"):
+                shutil.copy2(source, target_package / source.name)
+
+            environment = os.environ.copy()
+            environment.pop("PYTHONDONTWRITEBYTECODE", None)
+            environment.pop("PYTHONPYCACHEPREFIX", None)
+            completed = subprocess.run(
+                [sys.executable, str(target_scripts / "preflight_root.py"), "--help"],
+                cwd=root,
+                env=environment,
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                check=False,
+            )
+
+            self.assertEqual(0, completed.returncode, completed.stderr)
+            self.assertEqual([], list(root.rglob("*.pyc")))
+            self.assertEqual([], list(root.rglob("__pycache__")))
+
+
+if __name__ == "__main__":
+    unittest.main()
