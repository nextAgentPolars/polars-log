--- /dev/null
+++ b/scripts/root_preflight/workflows.py
@@ -0,0 +1,295 @@
+"""Bounded, fail-closed GitHub workflow wiring checks."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, Sequence
+
+from .common import (
+    MAX_WORKFLOW_BYTES,
+    add_check,
+    dependency_reaches,
+    dependency_subgraph_valid,
+    read_bounded_text,
+)
+
+
+ROOT_TEST_COMMAND = "python3 -B -m unittest scripts.tests.test_preflight_release scripts.tests.test_preflight_repository scripts.tests.test_preflight_root scripts.tests.test_preflight_workflows"
+DEVELOPMENT_COMMAND = "python3 scripts/preflight_root.py --profile development"
+TRUSTED_SETUP_ACTIONS = (
+    "actions/checkout@",
+    "actions/setup-go@",
+    "actions/setup-node@",
+    "actions/setup-python@",
+)
+BACKEND_SAFE_JOB_IF = "github.event_name == 'workflow_dispatch' && inputs.run_supported_domain_matrix"
+SEALED_RELEASE_WORKFLOW = (
+    'name: "Release: Sealed pending M10 qualification"\n'
+    "\n"
+    "on:\n"
+    "  push:\n"
+    "    tags:\n"
+    '      - "v*"\n'
+    "\n"
+    "permissions: {}\n"
+    "\n"
+    "jobs:\n"
+    "  release-sealed:\n"
+    "    name: Release blocked pending M10 qualification\n"
+    "    runs-on: ubuntu-latest\n"
+    "    steps:\n"
+    "      - name: Emit fail-closed release receipt\n"
+    "        shell: bash\n"
+    "        run: |\n"
+    '          echo "::error title=Release sealed::ROOT_PREFLIGHT_RELEASE_QUALIFICATION_UNAVAILABLE"\n'
+    '          echo "M10 qualification owner, runners, and all 10 evidence kinds are not established."\n'
+    "          exit 2\n"
+)
+
+
+def workflow_text(repo_root: Path, relative: str) -> str:
+    return read_bounded_text(repo_root / relative, MAX_WORKFLOW_BYTES)
+
+
+def workflow_job_range(text: str, job_name: str) -> tuple[list[str], int, int] | None:
+    lines = text.splitlines()
+    jobs = [index for index, line in enumerate(lines) if re.fullmatch(r"jobs:\s*", line)]
+    if len(jobs) != 1:
+        return None
+    pattern = re.compile(rf"^  {re.escape(job_name)}:\s*$")
+    starts = [index for index in range(jobs[0] + 1, len(lines)) if pattern.match(lines[index])]
+    if len(starts) != 1:
+        return None
+    next_job = re.compile(r"^  [A-Za-z0-9_.-]+:\s*$")
+    end = next((index for index in range(starts[0] + 1, len(lines)) if next_job.match(lines[index])), len(lines))
+    return lines, starts[0], end
+
+
+def workflow_job_block(text: str, job_name: str) -> str:
+    extracted = workflow_job_range(text, job_name)
+    if extracted is None:
+        return ""
+    lines, start, end = extracted
+    return "\n".join(lines[start:end])
+
+
+def workflow_job_names(text: str) -> list[str] | None:
+    lines = text.splitlines()
+    jobs = [index for index, line in enumerate(lines) if re.fullmatch(r"jobs:\s*", line)]
+    if len(jobs) != 1:
+        return None
+    names = [match.group(1) for line in lines[jobs[0] + 1 :] if (match := re.match(r"^  ([A-Za-z0-9_.-]+):\s*$", line))]
+    return names if names and len(names) == len(set(names)) else None
+
+
+def _job_values(text: str, job_name: str, field: str) -> list[str] | None:
+    block = workflow_job_block(text, job_name)
+    if not block:
+        return None
+    pattern = re.compile(rf"^    {re.escape(field)}:\s*(.*)$")
+    return [match.group(1).strip() for line in block.splitlines() if (match := pattern.match(line))]
+
+
+def workflow_job_needs(text: str, job_name: str) -> set[str] | None:
+    block = workflow_job_block(text, job_name)
+    if not block:
+        return None
+    lines = block.splitlines()
+    matches = [(index, match.group(1).strip()) for index, line in enumerate(lines) if (match := re.match(r"^    needs:\s*(.*)$", line))]
+    if len(matches) > 1:
+        return None
+    if not matches:
+        return set()
+    index, value = matches[0]
+    if value.startswith("[") and value.endswith("]"):
+        return {item.strip().strip("'\"") for item in value[1:-1].split(",") if item.strip()}
+    if value:
+        return {value.strip("'\"")}
+    needs: set[str] = set()
+    for line in lines[index + 1 :]:
+        if line.strip() and len(line) - len(line.lstrip()) <= 4:
+            break
+        if line.strip():
+            child = re.fullmatch(r"      -\s*([A-Za-z0-9_.-]+)\s*", line)
+            if child is None:
+                return None
+            needs.add(child.group(1))
+    return needs or None
+
+
+def workflow_job_graph(text: str) -> dict[str, set[str]] | None:
+    names = workflow_job_names(text)
+    if names is None:
+        return None
+    graph: dict[str, set[str]] = {}
+    for name in names:
+        needs = workflow_job_needs(text, name)
+        if needs is None:
+            return None
+        graph[name] = needs
+    return graph if all(dependency_subgraph_valid(name, graph) for name in names) else None
+
+
+def workflow_steps(text: str, job_name: str) -> list[dict[str, str]] | None:
+    extracted = workflow_job_range(text, job_name)
+    if extracted is None:
+        return None
+    lines, start, end = extracted
+    sections = [index for index in range(start + 1, end) if re.fullmatch(r"    steps:\s*", lines[index])]
+    if len(sections) != 1:
+        return None
+    starts = [index for index in range(sections[0] + 1, end) if re.match(r"^      -(?:\s+.*)?$", lines[index])]
+    if not starts:
+        return None
+    steps: list[dict[str, str]] = []
+    for position, step_start in enumerate(starts):
+        step_end = starts[position + 1] if position + 1 < len(starts) else end
+        entries: list[tuple[str, str, int]] = []
+        inline = re.fullmatch(r"      -(?:\s+([A-Za-z0-9_-]+):\s*(.*))?", lines[step_start])
+        if inline is None:
+            return None
+        if inline.group(1):
+            entries.append((inline.group(1), inline.group(2), step_start))
+        for index in range(step_start + 1, step_end):
+            match = re.match(r"^        ([A-Za-z0-9_-]+):\s*(.*)$", lines[index])
+            if match:
+                entries.append((match.group(1), match.group(2), index))
+            elif lines[index].strip() and len(lines[index]) - len(lines[index].lstrip()) < 8:
+                return None
+        fields: dict[str, str] = {"line": str(step_start)}
+        if len({key for key, _value, _line in entries}) != len(entries):
+            return None
+        for entry_index, (key, value, line_index) in enumerate(entries):
+            if value in {"|", ">", "|-", ">-", "|+", ">+"}:
+                next_line = entries[entry_index + 1][2] if entry_index + 1 < len(entries) else step_end
+                value = "\n".join(line.strip() for line in lines[line_index + 1 : next_line] if line.strip())
+            fields[key] = value
+        steps.append(fields)
+    return steps
+
+
+def workflow_run_lines(text: str, job_name: str) -> list[tuple[int, str]] | None:
+    steps = workflow_steps(text, job_name)
+    if steps is None:
+        return None
+    return [(int(step["line"]), step["run"]) for step in steps if "run" in step]
+
+
+def workflow_all_run_lines(text: str) -> list[tuple[int, str]] | None:
+    names = workflow_job_names(text)
+    if names is None:
+        return None
+    result: list[tuple[int, str]] = []
+    for name in names:
+        runs = workflow_run_lines(text, name)
+        if runs is None:
+            return None
+        result.extend(runs)
+    return result
+
+
+def _false_or_absent(value: str | None) -> bool:
+    return value is None or value.lower() == "false"
+
+
+def _step_unconditional(step: dict[str, str]) -> bool:
+    return "if" not in step and _false_or_absent(step.get("continue-on-error"))
+
+
+def _job_failure_blocking(
+    text: str,
+    job_name: str,
+    *,
+    allowed_conditions: Sequence[str] = (),
+) -> bool:
+    continuations = _job_values(text, job_name, "continue-on-error")
+    conditions = _job_values(text, job_name, "if")
+    if continuations is None or conditions is None or len(continuations) > 1 or len(conditions) > 1:
+        return False
+    if continuations and not _false_or_absent(continuations[0]):
+        return False
+    return not conditions or conditions[0] in allowed_conditions
+
+
+def _trusted_job(
+    text: str,
+    job_name: str,
+    required_commands: Sequence[str],
+    action_prefixes: Sequence[str],
+) -> bool:
+    steps = workflow_steps(text, job_name)
+    if steps is None or not _job_failure_blocking(text, job_name):
+        return False
+    seen = {command: 0 for command in required_commands}
+    for step in steps:
+        if not _step_unconditional(step):
+            return False
+        if "uses" in step and step["uses"].startswith(tuple(action_prefixes)):
+            continue
+        command = step.get("run")
+        if command in seen:
+            seen[command] += 1
+        else:
+            return False
+    return all(count == 1 for count in seen.values())
+
+
+def marker_before_unsafe(text: str, marker: str, marker_job: str, unsafe_markers: Sequence[str]) -> bool:
+    del unsafe_markers
+    steps = workflow_steps(text, marker_job)
+    if steps is None or not _job_failure_blocking(text, marker_job):
+        return False
+    gates = [index for index, step in enumerate(steps) if step.get("run") == marker]
+    if len(gates) != 1 or not _step_unconditional(steps[gates[0]]):
+        return False
+    for step in steps[: gates[0]]:
+        if not _step_unconditional(step) or not step.get("uses", "").startswith(TRUSTED_SETUP_ACTIONS):
+            return False
+    return all("if" not in step for step in steps[gates[0] + 1 :])
+
+
+def backend_workflow_structure_ok(text: str, marker: str) -> bool:
+    graph = workflow_job_graph(text)
+    names = workflow_job_names(text) or []
+    if graph is None or text.count('      - ".github/workflows/release.yml"') != 2:
+        return False
+    candidates = [name for name in names if _trusted_job(text, name, (ROOT_TEST_COMMAND, marker), TRUSTED_SETUP_ACTIONS)]
+    if len(candidates) != 1:
+        return False
+    preflight = candidates[0]
+    return all(
+        name == preflight
+        or (
+            workflow_steps(text, name) is not None
+            and _job_failure_blocking(text, name, allowed_conditions=(BACKEND_SAFE_JOB_IF,))
+            and dependency_reaches(name, preflight, graph)
+        )
+        for name in names
+    )
+
+
+def check_development_workflow_wiring(report: dict[str, Any], blockers: list[str], repo_root: Path) -> None:
+    checks: list[bool] = []
+    try:
+        checks.append(backend_workflow_structure_ok(workflow_text(repo_root, ".github/workflows/ci-backend.yml"), DEVELOPMENT_COMMAND))
+    except (OSError, UnicodeError, ValueError):
+        checks.append(False)
+    try:
+        desktop = workflow_text(repo_root, ".github/workflows/ci-desktop.yml")
+        checks.append(marker_before_unsafe(desktop, DEVELOPMENT_COMMAND, "build-desktop", ()))
+    except (OSError, UnicodeError, ValueError):
+        checks.append(False)
+    try:
+        checks.append(workflow_text(repo_root, ".github/workflows/release.yml") == SEALED_RELEASE_WORKFLOW)
+    except (OSError, UnicodeError, ValueError):
+        checks.append(False)
+    add_check(report, blockers, "wiring.ci.development", all(checks), "ROOT_PREFLIGHT_CI_UNWIRED", "bounded development dominance plus exact release seal")
+
+
+def check_release_workflow_wiring(report: dict[str, Any], blockers: list[str], repo_root: Path) -> None:
+    try:
+        passed = workflow_text(repo_root, ".github/workflows/release.yml") == SEALED_RELEASE_WORKFLOW
+    except (OSError, UnicodeError, ValueError):
+        passed = False
+    add_check(report, blockers, "wiring.ci.release", passed, "ROOT_PREFLIGHT_RELEASE_UNWIRED", "exact fail-closed M10 sealed sentinel; no release action surface")
