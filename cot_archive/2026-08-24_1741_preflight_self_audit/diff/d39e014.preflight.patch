+            "ROOT_PREFLIGHT_GIT_TRUTH_UNAVAILABLE",
+            "HEAD/ref/status",
+        )
+
+        if head_ok:
+            report["repo"]["head"] = head
+        if ref_ok:
+            report["repo"]["ref"] = ref or "DETACHED"
+        dirty = status != "" if status_ok else None
+        status_hash = status_sha256(status) if status_ok else None
+        if status_ok:
