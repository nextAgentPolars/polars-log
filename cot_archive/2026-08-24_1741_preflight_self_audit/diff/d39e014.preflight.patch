+++ b/scripts/root_preflight/common.py
@@ -0,0 +1,231 @@
+"""Shared, owner-neutral primitives for the root preflight."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import selectors
+import subprocess
+import time
+from pathlib import Path
+from typing import Any, Callable, Collection, Mapping, Sequence
+
+
+SCHEMA_VERSION = "polaris.root_preflight.v1"
+CommandRunner = Callable[[Sequence[str], Path], subprocess.CompletedProcess[str]]
+ToolLocator = Callable[[str], str | None]
+MAX_COMMAND_OUTPUT_BYTES = 256 * 1024
+MAX_COMMAND_SECONDS = 30
+MAX_JSON_BYTES = 1024 * 1024
+MAX_MAKE_BYTES = 256 * 1024
+MAX_WORKFLOW_BYTES = 512 * 1024
+MAX_STATIC_FILE_BYTES = 1024 * 1024
+MAX_STATIC_GLOB_FILES = 32
+MAX_STATIC_SUBPROCESS_TASKS = 48
+MAX_EVIDENCE_REF_BYTES = 1024 * 1024
+MAX_GRAPH_NODES = 256
+MAX_GRAPH_DEPTH = 64
+MAX_GRAPH_EDGES = 1024
+
+
+def dependency_subgraph_valid(root: str, graph: Mapping[str, Collection[str]]) -> bool:
+    """Prove the reachable dependency subgraph is complete and acyclic."""
+
+    active: set[str] = set()
+    done: set[str] = set()
+
+    if len(graph) > MAX_GRAPH_NODES or sum(len(edges) for edges in graph.values()) > MAX_GRAPH_EDGES:
+        return False
+
+    def visit(node: str, depth: int) -> bool:
+        if depth > MAX_GRAPH_DEPTH or node not in graph or node in active:
+            return False
+        if node in done:
+            return True
+        active.add(node)
+        passed = all(visit(dependency, depth + 1) for dependency in graph[node])
+        active.remove(node)
+        if passed:
+            done.add(node)
+        return passed
+
+    return visit(root, 0)
+
+
+def dependency_reaches(root: str, ancestor: str, graph: Mapping[str, Collection[str]]) -> bool:
+    """Return whether a dependency path reaches the named ancestor."""
+
+    if len(graph) > MAX_GRAPH_NODES or sum(len(edges) for edges in graph.values()) > MAX_GRAPH_EDGES:
+        return False
+    pending = [(root, 0)]
+    visited: set[str] = set()
+    while pending:
+        node, depth = pending.pop()
+        if depth > MAX_GRAPH_DEPTH or node not in graph:
+            return False
+        if node == ancestor:
+            return True
+        if node not in visited:
+            visited.add(node)
+            pending.extend((dependency, depth + 1) for dependency in graph[node])
+    return False
+
+
+def default_command_runner(args: Sequence[str], cwd: Path) -> subprocess.CompletedProcess[str]:
+    """Run one probe with bounded time and combined output."""
+
+    command = list(args)
+    process = subprocess.Popen(
+        command,
+        cwd=str(cwd),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=False,
+    )
+    selector = selectors.DefaultSelector()
+    streams = {"stdout": process.stdout, "stderr": process.stderr}
+    buffers = {name: bytearray() for name in streams}
+    for name, stream in streams.items():
+        if stream is not None:
+            selector.register(stream, selectors.EVENT_READ, name)
+    deadline = time.monotonic() + MAX_COMMAND_SECONDS
+    try:
+        while selector.get_map():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                process.kill()
+                process.wait()
+                return subprocess.CompletedProcess(command, 124, "", "probe timeout")
+            for key, _mask in selector.select(remaining):
+                total = sum(len(value) for value in buffers.values())
+                chunk = os.read(key.fd, min(65536, MAX_COMMAND_OUTPUT_BYTES - total + 1))
+                if not chunk:
+                    selector.unregister(key.fileobj)
+                    continue
+                buffers[key.data].extend(chunk)
+                if sum(len(value) for value in buffers.values()) > MAX_COMMAND_OUTPUT_BYTES:
+                    process.kill()
+                    process.wait()
+                    return subprocess.CompletedProcess(command, 125, "", "probe output limit")
+        try:
+            returncode = process.wait(timeout=max(0.1, deadline - time.monotonic()))
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+            return subprocess.CompletedProcess(command, 124, "", "probe timeout")
+        stdout = buffers["stdout"].decode("utf-8", errors="replace")
+        stderr = buffers["stderr"].decode("utf-8", errors="replace")
+        return subprocess.CompletedProcess(command, returncode, stdout, stderr)
+    finally:
+        selector.close()
+        for stream in streams.values():
+            if stream is not None:
+                stream.close()
+
+
+def is_within(root: Path, candidate: Path) -> bool:
+    try:
+        candidate.relative_to(root)
+        return True
+    except ValueError:
+        return False
+
+
+def relative_evidence(root: Path, path: Path) -> str:
+    try:
+        return path.resolve().relative_to(root.resolve()).as_posix()
+    except ValueError:
+        return "<outside-repo>"
+
+
+def normalise_command_text(text: str) -> str:
+    """Join shell continuation lines while keeping ordering deterministic."""
+
+    return re.sub(r"\\\s*\n\s*", " ", text)
+
+
+def status_sha256(status: str) -> str:
+    # release-evidence/io.mjs uses runGit(...).trim() before hashing status.
+    return hashlib.sha256(status.strip().encode("utf-8")).hexdigest()
+
+
+def file_sha256(path: Path, max_bytes: int | None = None) -> str:
+    if max_bytes is not None and path.stat().st_size > max_bytes:
+        raise ValueError("input exceeds resource limit")
+    digest = hashlib.sha256()
+    total = 0
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            total += len(chunk)
+            if max_bytes is not None and total > max_bytes:
+                raise ValueError("input exceeds resource limit")
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def read_bounded_text(path: Path, max_bytes: int) -> str:
+    with path.open("rb") as handle:
+        payload = handle.read(max_bytes + 1)
+    if len(payload) > max_bytes:
+        raise ValueError("input exceeds resource limit")
+    return payload.decode("utf-8")
+
+
+def bounded_glob_files(directory: Path, suffix: str) -> list[Path]:
+    """Return one bounded, deterministic set of direct child files."""
+
+    matches: list[Path] = []
+    try:
+        entries = os.scandir(directory)
+    except FileNotFoundError:
+        return matches
+    with entries:
+        for entry in entries:
+            if entry.is_file() and entry.name.endswith(suffix):
+                if len(matches) >= MAX_STATIC_GLOB_FILES:
+                    raise ValueError("static glob exceeds resource limit")
+                matches.append(Path(entry.path))
+    return sorted(matches)
+
+
+def add_check(
+    report: dict[str, Any],
+    blockers: list[str],
+    check_id: str,
+    passed: bool,
+    reason_code: str,
+    evidence: str,
+) -> None:
+    report["checks"].append(
+        {
+            "id": check_id,
+            "status": "passed" if passed else "blocked",
+            "reason_code": None if passed else reason_code,
+            "evidence": evidence,
+        }
+    )
+    if not passed and reason_code not in blockers:
+        blockers.append(reason_code)
+
+
+def new_report(profile: str, repo_root: Path) -> dict[str, Any]:
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "profile": profile,
+        "status": "blocked",
+        "repo": {
+            "root": str(repo_root.resolve()),
+            "head": None,
+            "ref": None,
+            "dirty": None,
+            "status_sha256": None,
+        },
+        "checks": [],
+        "blockers": [],
+    }
+
+
+def parse_json(path: Path) -> Any:
+    return json.loads(read_bounded_text(path, MAX_JSON_BYTES))
