+#!/usr/bin/env python3
+"""Read-only repository admission preflight CLI and orchestration."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+from typing import Any, Mapping, Sequence
+
+# The entrypoint is read-only, including its import-time package loading.
+# Keep local owner modules from creating repository bytecode caches.
+sys.dont_write_bytecode = True
+
+try:
+    import root_preflight.common as _common
+    import root_preflight.release as _release
+    import root_preflight.repository as _repository
+    import root_preflight.workflows as _workflows
+except ModuleNotFoundError:  # package import when called as scripts.preflight_root
+    import scripts.root_preflight.common as _common
+    import scripts.root_preflight.release as _release
+    import scripts.root_preflight.repository as _repository
+    import scripts.root_preflight.workflows as _workflows
+
+CommandRunner = _common.CommandRunner
+SCHEMA_VERSION = _common.SCHEMA_VERSION
+ToolLocator = _common.ToolLocator
+_add_check = _common.add_check
+_default_command_runner = _common.default_command_runner
+_file_sha256 = _common.file_sha256
+_is_within = _common.is_within
+_new_report = _common.new_report
+_normalise_command_text = _common.normalise_command_text
+_parse_json = _common.parse_json
+_relative_evidence = _common.relative_evidence
+_status_sha256 = _common.status_sha256
+
+JSON_STATIC_FILES = _repository.JSON_STATIC_FILES
+NODE_STATIC_FILES = _repository.NODE_STATIC_FILES
+PYTHON_STATIC_FILES = _repository.PYTHON_STATIC_FILES
+REQUIRED_FILES = _repository.REQUIRED_FILES
+REQUIRED_TOOLS = _repository.REQUIRED_TOOLS
+SHELL_STATIC_FILES = _repository.SHELL_STATIC_FILES
+TOOLCHAIN_PATH_VARS = _repository.TOOLCHAIN_PATH_VARS
+_check_entrypoint_wiring = _repository.check_entrypoint_wiring
+_check_make_wiring = _repository.check_make_wiring
+_check_psi_anchors = _repository.check_psi_anchors
+_check_repo_truth = _repository.check_repo_truth
+_check_required_files = _repository.check_required_files
+_check_static_syntax = _repository.check_static_syntax
+_check_tools = _repository.check_tools
+_git_probe = _repository.git_probe
+
+_backend_workflow_structure_ok = _workflows.backend_workflow_structure_ok
+_check_development_workflow_wiring = _workflows.check_development_workflow_wiring
+_check_release_workflow_wiring = _workflows.check_release_workflow_wiring
+_workflow_all_run_lines = _workflows.workflow_all_run_lines
+_workflow_job_block = _workflows.workflow_job_block
+_workflow_job_range = _workflows.workflow_job_range
+_workflow_marker_before_unsafe = _workflows.marker_before_unsafe
+_workflow_run_lines = _workflows.workflow_run_lines
+_workflow_text = _workflows.workflow_text
+
+_check_bundle_shape = _release.check_bundle_shape
+_check_matrix_binding = _release.check_matrix_binding
+_check_matrix_items = _release.check_matrix_items
+_check_release_evidence = _release.check_release_evidence
+_check_source_binding = _release.check_source_binding
+_is_sha256 = _release.is_sha256
+_matrix_items = _release.matrix_items
+_parse_release_timestamp = _release.parse_release_timestamp
+_release_ref_matches = _release.release_ref_matches
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+MACOS_VOLUMES_ROOT = Path("/Volumes")
+
+class UsageError(ValueError):
+    """An invalid CLI invocation which maps to exit code 64."""
+
+class _ArgumentParser(argparse.ArgumentParser):
+    def error(self, message: str) -> None:  # pragma: no cover - exercised by main
+        raise UsageError(message)
+
+def _check_macos_toolchain(
+    report: dict[str, Any],
+    blockers: list[str],
+    repo_root: Path,
+    env: Mapping[str, str],
+    platform_name: str,
+    tool_paths: Mapping[str, str],
+    volumes_root: Path | None = None,
+) -> None:
+    _repository.check_macos_toolchain(
+        report,
+        blockers,
+        repo_root,
+        env,
+        platform_name,
+        tool_paths,
+        MACOS_VOLUMES_ROOT if volumes_root is None else volumes_root,
+    )
+
+def evaluate(
+    profile: str,
+    release_evidence: str | os.PathLike[str] | None = None,
+    *,
+    repo_root: Path = REPO_ROOT,
+    env: Mapping[str, str] | None = None,
+    platform_name: str | None = None,
+    command_runner: CommandRunner = _default_command_runner,
+    tool_locator: ToolLocator = shutil.which,
+) -> dict[str, Any]:
+    """Evaluate the contract with injectable repository and probe dependencies."""
+
+    root = Path(repo_root).resolve()
+    report = _new_report(profile, root)
+    blockers: list[str] = report["blockers"]
+    runtime_env = dict(os.environ if env is None else env)
+    try:
+        _add_check(report, blockers, "input.profile", profile in {"development", "release"}, "ROOT_PREFLIGHT_PROFILE_INVALID", profile)
+        head, _status, dirty, status_hash = _check_repo_truth(report, blockers, root, command_runner)
+        _check_required_files(report, blockers, root)
+        tool_paths = _check_tools(report, blockers, tool_locator)
+        _check_macos_toolchain(report, blockers, root, runtime_env, platform_name or sys.platform, tool_paths, MACOS_VOLUMES_ROOT)
+        _check_static_syntax(report, blockers, root, command_runner)
+        _check_psi_anchors(report, blockers, root)
+        _check_make_wiring(report, blockers, root)
+        _check_entrypoint_wiring(report, blockers, root)
+        _check_development_workflow_wiring(report, blockers, root)
+        if profile == "release":
+            _check_release_workflow_wiring(report, blockers, root)
+            _check_release_evidence(report, blockers, root, release_evidence, head, status_hash, dirty)
+    except Exception as exc:  # fail closed; never leak a traceback or command output
+        _add_check(report, blockers, "evaluator.internal", False, "ROOT_PREFLIGHT_INTERNAL_ERROR", type(exc).__name__)
+    report["status"] = "passed" if not blockers else "blocked"
+    return report
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = _ArgumentParser(
+        prog="scripts/preflight_root.py",
+        description="Read-only Polaris development/release admission preflight.",
+        epilog=(
+            "macOS toolchain invocation: source /Volumes/移动硬盘/polars-toolchain/env.sh "
+            "&& python3 scripts/preflight_root.py --profile development; "
+            "POLARIS_TOOLCHAIN_ROOT may target any external /Volumes/... root"
+        ),
+    )
+    parser.add_argument("--profile", required=True, help="development or release")
+    parser.add_argument("--release-evidence", help="explicit release evidence bundle path")
+    return parser
+
+def _print_json(payload: Mapping[str, Any]) -> None:
+    print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
+
+def main(argv: Sequence[str] | None = None) -> int:
+    try:
+        args = _build_parser().parse_args(argv)
+        if args.profile not in {"development", "release"}:
+            raise UsageError("--profile must be development or release")
+    except UsageError as exc:
+        print(f"preflight_root: {exc}", file=sys.stderr)
+        return 64
+    except SystemExit as exc:  # --help
+        return int(exc.code or 0)
+    try:
+        report = evaluate(args.profile, args.release_evidence)
+    except Exception as exc:  # belt-and-suspenders contract boundary
+        report = _new_report(args.profile, REPO_ROOT)
+        report["blockers"] = ["ROOT_PREFLIGHT_INTERNAL_ERROR"]
+        report["checks"] = [{"id": "evaluator.internal", "status": "blocked", "reason_code": "ROOT_PREFLIGHT_INTERNAL_ERROR", "evidence": type(exc).__name__}]
+    report["status"] = "passed" if not report.get("blockers") else "blocked"
+    _print_json(report)
+    return 0 if report["status"] == "passed" else 2
+
+if __name__ == "__main__":
+    raise SystemExit(main())
