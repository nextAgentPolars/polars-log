+def _parse_version(text: str, prefix: str) -> tuple[int, int, int] | None:
+    match = re.search(rf"^{re.escape(prefix)}(\d+)\.(\d+)(?:\.(\d+))?", text)
+    return tuple(int(part or 0) for part in match.groups()) if match else None
