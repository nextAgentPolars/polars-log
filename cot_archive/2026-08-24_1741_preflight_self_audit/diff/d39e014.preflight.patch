+        )
+        self._write("scripts/preflight_root.py", "value = 1\n")
+        self._write("scripts/supported_domain_provider_preflight.py", "value = 1\n")
+        self._write("scripts/supported_domain_matrix_smoke.py", "value = 1\n")
