+                "dirty": False,
+                "dirty_allowed": False,
+                "dirty_status_sha256": hashlib.sha256(self.runner.status.strip().encode()).hexdigest(),
+            },
+            "evidence": evidence_records,
+        }
+        for key, value in overrides.items():
+            if key == "git":
+                payload["git"].update(value)  # type: ignore[union-attr]
+            elif key == "matrix":
+                payload["matrix"].update(value)  # type: ignore[union-attr]
+            else:
+                payload[key] = value
+        path = self.root / "release/evidence/bundle.json"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(payload), encoding="utf-8")
+        return path
+
+
+
+
+class FixtureTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.fixture = Fixture()
+
+    def tearDown(self) -> None:
+        self.fixture.close()
+
+    def assert_blocked(self, result: dict, reason: str) -> None:
+        self.assertEqual("blocked", result["status"])
+        self.assertIn(reason, result["blockers"])
