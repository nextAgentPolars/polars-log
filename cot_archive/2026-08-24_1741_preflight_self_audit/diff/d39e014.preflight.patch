+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+import sys
+from typing import Sequence
+from unittest import mock
+
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import preflight_root
+
+
+class FakeRunner:
+    def __init__(self, root: Path, *, status: str = "", diff_failed: bool = False) -> None:
+        self.root = root
+        self.status = status
+        self.diff_failed = diff_failed
+        self.calls: list[tuple[str, ...]] = []
+
+    def __call__(self, args: Sequence[str], cwd: Path) -> subprocess.CompletedProcess[str]:
+        command = tuple(args)
+        self.calls.append(command)
+        if command == ("git", "rev-parse", "--show-toplevel"):
+            return subprocess.CompletedProcess(args, 0, f"{self.root}\n", "")
+        if command == ("git", "rev-parse", "--verify", "HEAD"):
+            return subprocess.CompletedProcess(args, 0, f"{'a' * 40}\n", "")
+        if command == ("git", "branch", "--show-current"):
+            return subprocess.CompletedProcess(args, 0, "main\n", "")
+        if command == ("git", "status", "--short"):
+            return subprocess.CompletedProcess(args, 0, f"{self.status}\n", "")
+        if command == ("git", "diff", "--check"):
+            return subprocess.CompletedProcess(args, 1 if self.diff_failed else 0, "", "diff check failed\n" if self.diff_failed else "")
+        # Static syntax probes are intentionally represented by successful
+        # subprocess results; no fixture test invokes Go, pnpm, Docker, or a
+        # runtime.
+        return subprocess.CompletedProcess(args, 0, "", "")
+
+
+class Fixture:
+    def __init__(self, *, status: str = "", diff_failed: bool = False) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.runner = FakeRunner(self.root, status=status, diff_failed=diff_failed)
+        self._write_baseline()
+
+    def close(self) -> None:
+        self.temp.cleanup()
+
+    def _write(self, relative: str, text: str) -> None:
+        path = self.root / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text, encoding="utf-8")
+
+    def _write_baseline(self) -> None:
