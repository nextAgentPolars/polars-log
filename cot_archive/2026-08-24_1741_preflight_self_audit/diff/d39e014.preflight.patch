+            "ROOT_PREFLIGHT_ROOT_MISMATCH" if root_ok else "ROOT_PREFLIGHT_ROOT_UNRESOLVED",
+            "git rev-parse --show-toplevel",
+        )
+
+        head_ok, head = git_probe(repo_root, ["rev-parse", "--verify", "HEAD"], command_runner)
+        ref_ok, ref = git_probe(repo_root, ["branch", "--show-current"], command_runner)
+        status_ok, status = git_probe(repo_root, ["status", "--short"], command_runner)
+        head_shape_ok = bool(head) and re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", head) is not None
+        add_check(
