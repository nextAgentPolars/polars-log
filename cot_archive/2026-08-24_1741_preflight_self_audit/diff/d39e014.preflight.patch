+        target = match.group(0) if match else ""
+        graph = target_graph(text)
+        recipe_ok = any("scripts/preflight_root.py" in line and "--profile" in line and not re.search(r"\b(?:echo|printf)\b", line) for line in target.splitlines()[1:] if line.strip() and not line.lstrip().startswith("#"))
+        graph_ok = graph is not None and "preflight" in graph and all(
+            dependency_subgraph_valid(target_name, graph)
+            and dependency_reaches(target_name, "preflight", graph)
+            for target_name in dangerous_targets
+        )
+        passed = recipe_ok and graph_ok
+    except (OSError, UnicodeError, ValueError):
+        passed = False
+    add_check(report, blockers, "wiring.make", passed, "ROOT_PREFLIGHT_MAKE_UNWIRED", "preflight recipe and transitive prerequisites for build/test/lint/desktop/docker targets")
+
+def check_entrypoint_wiring(report: dict[str, Any], blockers: list[str], repo_root: Path) -> None:
+    passed = False
+    try:
+        matrix = parse_json(repo_root / "scripts/entrypoint_matrix.json")
+        entries = matrix.get("entrypoints") if isinstance(matrix, dict) else None
+        passed = isinstance(entries, list) and any(
+            isinstance(entry, dict)
+            and entry.get("path") == "scripts/preflight_root.py"
+            and entry.get("kind") == "python"
+            and isinstance(entry.get("verification_command"), str)
+            and "python3" in entry["verification_command"]
+            and "-B" in entry["verification_command"].split() and "py_compile" not in entry["verification_command"]
+            for entry in entries
+        )
+    except (OSError, UnicodeError, ValueError, AttributeError, TypeError):
+        pass
+    add_check(report, blockers, "wiring.entrypoint_matrix", passed, "ROOT_PREFLIGHT_ENTRYPOINT_UNWIRED", "scripts/entrypoint_matrix.json:scripts/preflight_root.py")
