+"""Release evidence hand-off validation."""
+
+from __future__ import annotations
+
+from datetime import datetime
+import re
+from pathlib import Path
+from typing import Any
+
+from .common import MAX_EVIDENCE_REF_BYTES, add_check, file_sha256, is_within, parse_json, relative_evidence
+
+
+def parse_release_timestamp(value: object) -> bool:
+    if not isinstance(value, str) or not value.strip():
+        return False
+    text = value.strip()
+    if text.endswith("Z"):
+        text = f"{text[:-1]}+00:00"
+    try:
+        datetime.fromisoformat(text)
+    except (TypeError, ValueError):
+        return False
+    return True
+
+
+def is_sha256(value: object) -> bool:
+    return isinstance(value, str) and re.fullmatch(r"[0-9a-fA-F]{64}", value) is not None
+
+
+def normalise_ref(value: object) -> str | None:
+    if not isinstance(value, str):
+        return None
+    value = value.strip()
+    return "DETACHED" if value == "" else value
+
+
+def release_ref_matches(repo_root: Path, ref: object, expected_kind: object) -> bool:
+    if not isinstance(ref, dict) or ref.get("kind") != expected_kind or ref.get("exists") is not True:
+        return False
+    raw_path = ref.get("path")
+    if not isinstance(raw_path, str) or not raw_path.strip() or not is_sha256(ref.get("sha256")):
+        return False
+    candidate = Path(raw_path).expanduser()
+    if not candidate.is_absolute():
+        candidate = repo_root / candidate
+    try:
+        resolved = candidate.resolve()
+    except OSError:
+        return False
+    if not is_within(repo_root.resolve(), resolved) or not resolved.is_file():
+        return False
+    try:
+        return file_sha256(resolved, MAX_EVIDENCE_REF_BYTES).lower() == str(ref["sha256"]).lower()
+    except (KeyError, OSError, ValueError):
+        return False
+
+
+def matrix_items(matrix: object) -> tuple[str | None, list[dict[str, object]]]:
+    if not isinstance(matrix, dict):
+        return None, []
+    matrix_id = matrix.get("matrix_id")
+    raw_items = matrix.get("required_items")
+    if not isinstance(matrix_id, str) or not matrix_id.strip() or not isinstance(raw_items, list):
+        return None, []
+    items: list[dict[str, object]] = []
